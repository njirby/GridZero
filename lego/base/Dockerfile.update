# Fast in-place update of an existing base image (no pip / no network): re-applies only
# the layers that change when backend/cli/docs/entrypoint change. Use when PyPI is slow:
#   UPDATE_FROM=gridzero-rl-base:v1 bash lego/base/build.sh gridzero-rl-base:v2
# Must stay in sync with the tail of lego/base/Dockerfile (from `useradd` down).
ARG BASE
FROM ${BASE}

RUN id agent >/dev/null 2>&1 || useradd -m -u 1000 -s /bin/bash agent

WORKDIR /app
RUN rm -rf /app/backend /app/docs /app/recipes
COPY backend/ /app/backend/
COPY cli/simctl /usr/local/bin/simctl
RUN chmod +x /usr/local/bin/simctl
COPY AGENTS.md /app/AGENTS.md
COPY docs/ /app/docs/
COPY recipes/ /app/recipes/
# Grid data from GRID_ENVS (build.sh); adds grids on top of the base image's.
COPY data_grid2op/ /root/data_grid2op/

ENV OPENCODE_DISABLE=1 \
    RENDER_DISABLED=1 \
    SIMCTL_NO_RESET=1 \
    SIMCTL_BACKEND_PORT=8731 \
    MPLBACKEND=Agg \
    PYTHONUNBUFFERED=1

RUN mkdir -p /logs/agent /logs/artifacts /logs/verifier \
    && chmod 777 /logs/agent /logs/artifacts \
    && chmod 755 /logs /logs/verifier

# Hide the episode length from the agent: SIM_HORIZON reaches every docker-exec'd process via
# the container env, so non-root bash (Harbor launches opencode via `bash -c` as agent, and
# opencode's tool shells inherit) drops it. Root (entrypoint, verifier) keeps it.
RUN mkdir -p /etc/gridzero \
    && printf '[ "$(id -u)" = 0 ] || unset SIM_HORIZON\n' > /etc/gridzero/agent_env.sh \
    && chmod 644 /etc/gridzero/agent_env.sh
ENV BASH_ENV=/etc/gridzero/agent_env.sh

COPY lego/base/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8731
ENTRYPOINT ["/entrypoint.sh"]
