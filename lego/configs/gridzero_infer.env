# lego-rl INFER config — single grid2op trial (Phase 4 plumbing check).
# Launch: bash scripts/infer/infer.sh /home/nate/Documents/GridZero/lego/configs/gridzero_infer.env
#
# Starts a standalone vLLM (4B) on card 0, then runs ONE harbor trial:
#   opencode (in container) -> in-process proxy -> vLLM -> simctl -> verifier -> reward.
# No trainer. Validates the full capture/reward chain before the GRPO smoke.

# --- template selection ---
BACKEND=docker
SCAFFOLD=oc

# --- identity ---
PROJECT_NAME=gridzero
EXP_NAME=infer-smoke

# --- runtime ---
VENV_PATH=/home/nate/Documents/lego-rl/.venv
# Use only card 0 (cards 2-3 run the 27B host; card 1 stays free).
CUDA_VISIBLE_DEVICES=0

# --- model ---
MODEL_PATH=/home/nate/.cache/huggingface/hub/models--Qwen--Qwen3.5-4B/snapshots/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
SERVED_MODEL_NAME=qwen3.5-4b
TOOL_CALL_PARSER=qwen3_coder

# --- data / output ---
INDEX_FILE=/home/nate/Documents/GridZero/lego/index/gridzero_val.parquet
RESULTS_DIR=/home/nate/Documents/GridZero/lego/infer_results/${EXP_NAME}
OUTPUT_INDEX=/home/nate/Documents/GridZero/lego/infer_results/${EXP_NAME}/selected.parquet

# --- rollout (single trial) ---
N_TRIALS=1
N_CONCURRENT=1
TEMPERATURE=1.0
TRIAL_HARD_TIMEOUT_SEC=1800

# --- vLLM (single GPU replica) ---
GEN_TP=1
GPUS_PER_NODE=1
VLLM_PORT=8011
VLLM_MAX_MODEL_LEN=40960
GPU_MEM_UTIL=0.85
# Growing agent context gets the big share; per-turn gen is small.
MAX_RESPONSE_LEN=8192

# --- template composition ---
TEMPLATE_MODULES=(
  runtime/process.env
  infer/vllm.env
  infer/common.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
