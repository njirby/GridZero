# lego-rl INFER config — single grid2op trial (Phase 4 plumbing check).
# Launch: bash scripts/infer/infer.sh /home/nate/Documents/GridZero/lego/configs/gridzero_infer.env
#
# Starts a standalone vLLM (4B) on card 0, then runs ONE harbor trial:
#   opencode (in container) -> in-process proxy -> vLLM -> simctl -> verifier -> reward.
# No trainer. Validates the full capture/reward chain before the GRPO smoke.

# --- template selection ---
BACKEND=docker
SCAFFOLD=oc

# --- identity ---
PROJECT_NAME=gridzero
EXP_NAME=infer-smoke

# --- runtime ---
VENV_PATH=/home/nate/Documents/lego-rl/.venv
# Cards 0-1 for the RL work (cards 2-3 run the 27B host). TP=2 for 4B @ 128k.
CUDA_VISIBLE_DEVICES=0,1
# This host has no eth0; use the default-route iface (gloo/nccl need a real iface). Detected, not hard-coded:
# the wifi NIC renames across reboots (wlp226s0 -> wlp225s0 on 2026-10-07).
TRAIN_NETWORK_INTERFACE=$(ip route show default | awk '{print $5; exit}')

# --- model ---
MODEL_PATH=/home/nate/.cache/huggingface/hub/models--Qwen--Qwen3.5-4B/snapshots/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
SERVED_MODEL_NAME=qwen3.5-4b
TOOL_CALL_PARSER=qwen3_coder

# --- data / output ---
INDEX_FILE=/home/nate/Documents/GridZero/lego/index/gridzero_val.parquet
RESULTS_DIR=/home/nate/Documents/GridZero/lego/infer_results/${EXP_NAME}
OUTPUT_INDEX=/home/nate/Documents/GridZero/lego/infer_results/${EXP_NAME}/selected.parquet

# --- rollout (single trial) ---
N_TRIALS=1
N_CONCURRENT=1
TEMPERATURE=1.0
TRIAL_HARD_TIMEOUT_SEC=1800

# --- vLLM (4B @ 128k on 2x3090, TP=2) ---
GEN_TP=2
GPUS_PER_NODE=2
VLLM_PORT=8011
# Container reaches host vLLM via the docker0 gateway (vLLM binds 0.0.0.0).
API_BASE=http://172.17.0.1:${VLLM_PORT}/v1
# 128k context: plenty of headroom for the operator-manual prompt + the full
# 24-step episode + opencode's ~32K output budget, no overflow/compaction needed.
VLLM_MAX_MODEL_LEN=131072
GPU_MEM_UTIL=0.85
# Growing agent context gets the big share; per-turn gen is small.
MAX_RESPONSE_LEN=8192

# --- docker backend (the infer path does NOT source lib/harbor_env.sh, so set the
#     backend env it would normally export; otherwise Python falls back to K8s) ---
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.remote_docker:RemoteDockerEnvironment
DOCKER_HOST=unix:///var/run/docker.sock
HARBOR_TRIALS_DIR=/home/nate/Documents/GridZero/lego/harbor_trials/${PROJECT_NAME}/${EXP_NAME}

# --- template composition ---
TEMPLATE_MODULES=(
  runtime/process.env
  infer/vllm.env
  infer/common.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
