# lego-rl run config — ASYNC 2+2 on l2rpn_idf_2023 (118 subs, opponent; 288-step episodes from the
# scenario start, reward relative to do-nothing; DN fails 228/800 train, 9/32 val chronics).
# Same stack as gridzero_2b_lora_async.env except data, turn cap, segments and timeouts.
# Needs image gridzero-rl-base:v3 (idf data) and lego/tasks_idf (make_tasks.py --env l2rpn_idf_2023).
#
# Base description — ASYNC 2+2: grid2op Qwen3.5-2B LoRA, FSDP trainer (SP=2) on cards 0-1,
# one vLLM rollout instance (TP=2) on cards 2-3; rollouts overlap training (fully-async verl).
# Derived from gridzero_2b_lora_scale.env: same model / LoRA / SP / windows / GSPO / reward / data;
# 16 prompts x 4 rollouts = 64 rollouts per update, one epoch of the 320 training scenarios.
# Launch: bash lego/scripts/run_train.sh lego/configs/gridzero_2b_lora_async.env
# Smoke:  bash lego/scripts/probe_async_sync.sh   (2 updates, tiny batch, sync canary)
#
# Weight sync is ADAPTER-ONLY: vLLM loads the frozen base from disk (load_format=safetensors in
# lego_rl_fully_async_fsdp.yaml) and each sync sends just the LoRA tensors over NCCL
# (verl engine_workers.update_weights -> CheckpointEngineManager -> vLLM add_lora).
#
# Most knobs are `${X:-default}` so probe_async_sync.sh can shrink the run from the environment.

# --- template selection ---
BACKEND=docker
SCAFFOLD=oc
TRAINING_MODE=async
MODEL_ENGINE=fsdp

# --- identity ---
PROJECT_NAME=gridzero
EXP_NAME=${EXP_NAME:-2b-lora-idf-async-$(date +%Y%m%d-%H%M%S)}

# --- runtime ---
VENV_PATH=/home/nate/Documents/lego-rl/.venv
WANDB_API_KEY="${WANDB_API_KEY:-}"
TRAINER_LOGGER="${TRAINER_LOGGER:-['console','wandb']}"
# All four cards: 0-1 trainer, 2-3 rollout (Ray assigns the split; the probe checks it is disjoint).
CUDA_VISIBLE_DEVICES=0,1,2,3
# This host has no eth0; use the default-route iface (the wifi NIC renames across reboots).
TRAIN_NETWORK_INTERFACE=$(ip route show default | awk '{print $5; exit}')
DOCKER_HOST=unix:///var/run/docker.sock
# 30GB RAM box: Ray's default object store (40GB) overcommits it. Cap it.
RAY_OBJECT_STORE_MEMORY=2000000000

# --- model (Qwen3.5-2B) ---
MODEL_PATH=/home/nate/.cache/huggingface/hub/models--Qwen--Qwen3.5-2B/snapshots/15852e8c16360a2fea060d615a32b45270f8a8fc
SERVED_MODEL_NAME=qwen3.5-2b
TOOL_CALL_PARSER=qwen3_coder

# --- LoRA ---
LORA_RANK=16
LORA_ALPHA=32
LORA_TARGET_MODULES=all-linear

# --- data (grid2op Harbor task index) ---
TRAIN_FILES=${TRAIN_FILES:-/home/nate/Documents/GridZero/lego/index/gridzero_idf_train.parquet}
VAL_FILES=${VAL_FILES:-/home/nate/Documents/GridZero/lego/index/gridzero_idf_val.parquet}

# --- cluster topology: one 4-GPU node split 2 (train) + 2 (rollout) ---
NNODES=1
NGPUS_PER_NODE=4
N_NODES_TRAIN=1
N_NODES_ROLLOUT=1
TRAINER_N_GPUS_PER_NODE=2
ROLLOUT_N_GPUS_PER_NODE=2

# --- model sizing ---
# Trainer: Ulysses SP=2 over cards 0-1 (dp=1), as in the scale config (needs our verl SP patch).
SP_SIZE=2
# Rollout: ONE vLLM instance, TP=2 over cards 2-3: one LoRA load per sync (no replica
# consistency to keep) and a single KV cache pooled across both cards for long episodes.
GEN_TP=${GEN_TP:-2}
# vLLM owns its cards outright (no colocated trainer), so no sleep/wake and a large KV budget.
ENABLE_SLEEP_MODE=False
GPU_MEM_UTIL=0.85
# Rollout concurrency is ~16 trials; this also avoids vLLM's 1024-request sampler warmup spike.
ROLLOUT_MAX_NUM_SEQS=64
# Rollout context = the model's native window (max_position_embeddings 262144). Only MAX_RESP
# tokens of a trajectory are trained (longer ones are truncated and keep their reward).
ROLLOUT_MAX_MODEL_LEN=262144
MAX_PROMPT=49152
MAX_RESP=${MAX_RESP:-65536}
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=196608
USE_DYNAMIC_BSZ=False
FUSED_KERNELS=True
ENABLE_R3=False
VLLM_ENABLE_EXPERT_PARALLEL=False
# Trainer cards hold no vLLM now. Params stay resident (pinned host copies drove systemd-oomd
# kills before); the LoRA optimizer state is tiny, so keep it on the GPU too.
ACTOR_FSDP_PARAM_OFFLOAD=False
ACTOR_FSDP_OPTIMIZER_OFFLOAD=False
REF_FSDP_PARAM_OFFLOAD=True
ENABLE_ACTIVATION_OFFLOAD=False
VERL_ACTIVATION_OFFLOAD_PIN=0

# --- weight sync ---
# NCCL checkpoint engine; buckets are allocated on trainer rank 0 and every rollout GPU. The
# rank-16 adapter is tens of MB, so 512 MB holds it in one bucket (verl default is 2048).
CHECKPOINT_ENGINE_BUCKET_MB=512

# --- algorithm (GRPO + GSPO) ---
ADV_ESTIMATOR=grpo
POLICY_LOSS_MODE=gspo
KL_LOSS_COEF=0.001
ENTROPY_COEFF=0.0
USE_KL_LOSS=False
# Old log-probs: recompute them on the trainer (bypass OFF). With bypass ON the rollout's own
# log-probs serve as old_log_prob, but GSPO's sequence-level clip (CLIP_LOW/HIGH 3e-4/4e-4) is
# narrower than the measured vLLM-vs-FSDP sequence mismatch (|log ratio| mean 6e-4, max 1.3e-3;
# probe 2026-10-12), so numerical noise alone clipped 25% of sequences at the first update.
# Bypass OFF costs one old_log_prob forward (~17 s vs ~46 s update_actor on the probe) and
# save_model_to_cpu per step (~8 GB more swap). Override with ROLLOUT_CORRECTION_BYPASS=True;
# BYPASS_KEEP_LOSS_MODE=1 then keeps the loss GSPO (preflight 10c otherwise demands bypass_mode).
ROLLOUT_CORRECTION_BYPASS=${ROLLOUT_CORRECTION_BYPASS:-False}
BYPASS_KEEP_LOSS_MODE=1
# Decoupled PPO for staleness: with bypass off, old_log_prob is recomputed with the CURRENT weights,
# so the PPO ratio starts at 1 and nothing corrects for stale samples having been drawn by the
# previous policy (P5 2026-10-12: half of update 2 was stale; rollout_corr/kl 4e-4 fresh vs 3.5e-2
# stale). Truncated IS weights pi_old/pi_rollout per token, capped at 2.0, fix that; fresh samples
# get weight ~1.
ROLLOUT_IS=${ROLLOUT_IS:-token}
ROLLOUT_IS_THRESHOLD=${ROLLOUT_IS_THRESHOLD:-2.0}
# Drop timeout / env_setup_failed trajectories from loss and group stats (common.env default list).
TRAJ_FILTER_ENABLE=True

# --- optim ---
ACTOR_LR=1e-4
LR_SCHEDULER=constant

# --- async batch mapping ---
# A rollouter "sample" is one prompt group (N_RESP rollouts). The trainer consumes
# ppo_mini_batch_size (= TRAIN_MINI_BSZ prompts) x REQUIRE_BATCHES per update:
# 1 scenario x 64 rollouts (GRPO group of 64) = 64 rollouts per update, one optimizer step.
TRAIN_PROMPT_BSZ=0
GEN_PROMPT_BSZ=1
TRAIN_MINI_BSZ=${TRAIN_MINI_BSZ:-1}
TRAIN_BSZ=${TRAIN_BSZ:-${TRAIN_MINI_BSZ}}
N_RESP=${N_RESP:-64}
REQUIRE_BATCHES=1
# Sync weights after every update; rollouts may run at most one version behind
# (staleness 1 -> up to 2x16 prompt groups queued or in flight).
TRIGGER_PARAMETER_SYNC_STEP=1
STALENESS=1
# Prompts (rollouter steps) to generate: 40 scenarios -> 40 updates.
TOTAL_ROLLOUT_STEPS=${TOTAL_ROLLOUT_STEPS:-40}
TOTAL_EPOCHS=1
PARTIAL_ROLLOUT=True

# --- cadence ---
TRAINER_VAL_BEFORE_TRAIN=${TRAINER_VAL_BEFORE_TRAIN:-True}
TRAINER_TEST_FREQ=${TRAINER_TEST_FREQ:-5}
TRAINER_SAVE_FREQ=${TRAINER_SAVE_FREQ:-10}

# --- rollout workers ---
# 2 agent-loop workers x 8 trials = 16 concurrent trials (RAM-bound: ~0.3-0.4GB per container,
# ~1.1GB per worker). The rollouter may request up to 2x16 prompt groups; this cap still holds.
AGENT_NUM_WORKERS=2
HARBOR_MAX_CONCURRENT_TRIALS=${HARBOR_MAX_CONCURRENT_TRIALS:-8}

# --- opencode proactive compaction (scaffold/oc.env) ---
# Compact at ~90k tokens so each context window fits a training row (MAX_PROMPT+MAX_RESP).
OC_CONTEXT_LIMIT=${OC_CONTEXT_LIMIT-98304}
OC_OUTPUT_LIMIT=${OC_OUTPUT_LIMIT:-8192}

# --- agent / harbor timeouts ---
# A 288-step episode needs >= 288 simctl act/step calls plus observes: cap turns at 400, allow up to
# 16 compaction segments, 2 h per trial (task.toml agent timeout is 7200 too).
HARBOR_AGENT_MAX_ITERATIONS=${HARBOR_AGENT_MAX_ITERATIONS:-400}
HARBOR_MAX_SEGMENTS=${HARBOR_MAX_SEGMENTS:-16}
HARBOR_AGENT_MAX_TIMEOUT_SEC=7200
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=7200
HARBOR_TRIALS_DIR=/home/nate/Documents/GridZero/lego/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
AGENT_LOOP_CONFIG_PATH=/home/nate/Documents/lego-rl/src/verl_patch/config/agent_loop_config_oc_docker.yaml

# --- template composition ---
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)

# Diagnostic: per-micro-batch GPU memory trace in verl forward_backward_batch (our patch).
VERL_MEM_TRACE=1

# --- agent prompt and tools (scaffold/oc.env) ---
# Replace opencode's coding-assistant persona (~9k chars) with a short task-neutral one; the
# operator manual is AGENTS.md. Withhold tools the grid task never needs (~20k chars of schemas);
# the agent keeps bash, read, glob, grep.
OC_AGENT_PROMPT_FILE=/home/nate/Documents/GridZero/lego/prompts/oc_system.md
OC_DISABLED_TOOLS=todowrite,task,webfetch,edit,write,skill
