# lego-rl run config — grid2op Qwen3.5-4B on one 4x3090 node (sync, colocated).
# Launch: bash scripts/train/train.sh /home/nate/Documents/GridZero/lego/configs/gridzero_4b_4x3090.env
#
# Axis selections (everything else is derived by harbor_env.sh + templates):
#   BACKEND=docker      -> RemoteDockerEnvironment (one container per trial, local daemon)
#   SCAFFOLD=oc         -> opencode adapter + docker.io/jierun/c-oc-1.14.22:v0.1 runtime
#   TRAINING_MODE=sync  -> vLLM + trainer colocate on the same GPUs (sleep-mode)
#   MODEL_ENGINE=fsdp   -> FSDP actor (param/optimizer offload; safe on 3090s)

# --- template selection ---
BACKEND=docker
SCAFFOLD=oc
TRAINING_MODE=sync
MODEL_ENGINE=fsdp

# FIXME: this file is named 4b-4x3090 but its uncommitted edits switched EXP_NAME,
# MODEL_PATH and SERVED_MODEL_NAME to Qwen3.5-2B (the 2B LoRA run uses 2 GPUs; see
# gridzero_2b_lora.env) but NGPUS_PER_NODE=4 is kept. Decide 4B/4 GPUs vs 2B and make them consistent.
# --- identity ---
PROJECT_NAME=gridzero
EXP_NAME=${EXP_NAME:-2b-4x3090-$(date +%Y%m%d-%H%M%S)}

# --- runtime ---
# Local docker daemon (harbor_env.sh would default this to a tcp://YOUR_DOCKER_HOST placeholder).
DOCKER_HOST=unix:///var/run/docker.sock
VENV_PATH=/home/nate/Documents/lego-rl/.venv
WANDB_API_KEY="${WANDB_API_KEY:-}"
TRAINER_LOGGER="['console']"
# This host has no eth0; use the default-route iface (ray/nccl/gloo/tp need a real iface). Detected, not hard-coded:
# the wifi NIC renames across reboots (wlp226s0 -> wlp225s0 on 2026-10-07).
TRAIN_NETWORK_INTERFACE=$(ip route show default | awk '{print $5; exit}')

# --- model ---
MODEL_PATH=/home/nate/.cache/huggingface/hub/models--Qwen--Qwen3.5-2B/snapshots/15852e8c16360a2fea060d615a32b45270f8a8fc
SERVED_MODEL_NAME=qwen3.5-2b
# Qwen3.5 is XML tool format -> qwen3_coder parser (must match chat template).
TOOL_CALL_PARSER=qwen3_coder

# --- data (grid2op Harbor task index; built by lego/make_tasks.py + create_task_index.py) ---
TRAIN_FILES=${TRAIN_FILES:-/home/nate/Documents/GridZero/lego/index/gridzero_train.parquet}
VAL_FILES=${VAL_FILES:-/home/nate/Documents/GridZero/lego/index/gridzero_val.parquet}

# --- cluster topology (one 4-GPU node, colocated) ---
NNODES=1
NGPUS_PER_NODE=4
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# --- model sizing (4B dense on 4x24GB) ---
# SP=1 (no sequence parallel; 4B is small). GEN_TP=1 -> 4 single-GPU vLLM replicas.
SP_SIZE=1
GEN_TP=1
# Sync colocates vLLM + trainer: vLLM must sleep during the actor update.
ENABLE_SLEEP_MODE=True
GPU_MEM_UTIL=0.6
# Context sized for a 24-step episode (growing agent context + per-turn gen).
MAX_PROMPT=16384
MAX_RESP=24576
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=40960
USE_DYNAMIC_BSZ=False
# Dense model: no routing replay / expert parallel.
ENABLE_R3=False
VLLM_ENABLE_EXPERT_PARALLEL=False
# FSDP offload (params + optimizer to CPU) to fit 24GB with full fine-tune.
ACTOR_FSDP_PARAM_OFFLOAD=True
ACTOR_FSDP_OPTIMIZER_OFFLOAD=True
REF_FSDP_PARAM_OFFLOAD=True

# --- algorithm (GRPO + GSPO, their default profile) ---
ADV_ESTIMATOR=grpo
POLICY_LOSS_MODE=gspo
KL_LOSS_COEF=0.001
ENTROPY_COEFF=0.0

# --- optim ---
ACTOR_LR=1e-6
LR_SCHEDULER=constant

# --- cadence ---
TOTAL_EPOCHS=1
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_TEST_FREQ=5
TRAINER_SAVE_FREQ=5

# --- smoke scale (override for real runs: TRAIN_BSZ=64 N_RESP=8) ---
TRAIN_BSZ=${TRAIN_BSZ:-2}
TRAIN_MINI_BSZ=${TRAIN_MINI_BSZ:-2}
N_RESP=${N_RESP:-2}
AGENT_NUM_WORKERS=8

# --- agent / harbor timeouts (a 24-step episode of LLM calls) ---
HARBOR_AGENT_MAX_ITERATIONS=60
HARBOR_AGENT_MAX_TIMEOUT_SEC=1800
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=1800
HARBOR_TRIALS_DIR=/home/nate/Documents/GridZero/lego/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
# oc scaffold on docker backend: use the agent-loop config that wires opencode's
# provider/runtime env (the docker default omits it). Must be AGENT_LOOP_CONFIG_PATH
# (see lego/NOTES.md "Agent-loop env var name"); plain AGENT_LOOP_CONFIG is ignored.
AGENT_LOOP_CONFIG_PATH=/home/nate/Documents/lego-rl/src/verl_patch/config/agent_loop_config_oc_docker.yaml

# --- template composition ---
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
