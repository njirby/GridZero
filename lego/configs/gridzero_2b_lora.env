# lego-rl run config — grid2op Qwen3.5-2B, LoRA, 2x3090 (cards 0-1), sync colocated.
# Launch: bash scripts/train/train.sh /home/nate/Documents/GridZero/lego/configs/gridzero_2b_lora.env
#
# Cards 2-3 run the 27B host — do not touch. This uses only cards 0-1.
# Goal: end-to-end GRPO smoke test + watch the reward trend (improving metrics).
#
# Axis selections:
#   BACKEND=docker      -> RemoteDockerEnvironment (one container per trial, local daemon)
#   SCAFFOLD=oc         -> opencode adapter + c-oc runtime
#   TRAINING_MODE=sync  -> vLLM + trainer colocate on the same GPUs (sleep-mode)
#   MODEL_ENGINE=fsdp   -> FSDP actor + LoRA (freeze base, train adapters)

# --- template selection ---
BACKEND=docker
SCAFFOLD=oc
TRAINING_MODE=sync
MODEL_ENGINE=fsdp

# --- identity ---
PROJECT_NAME=gridzero
EXP_NAME=${EXP_NAME:-2b-lora-$(date +%Y%m%d-%H%M%S)}

# --- runtime ---
VENV_PATH=/home/nate/Documents/lego-rl/.venv
WANDB_API_KEY="${WANDB_API_KEY:-}"
TRAINER_LOGGER="['console']"
# Only cards 0-1 (2-3 = 27B host).
CUDA_VISIBLE_DEVICES=0,1
# This host has no eth0; use the default-route iface (ray/nccl/gloo/tp need a real iface). Detected, not hard-coded:
# the wifi NIC renames across reboots (wlp226s0 -> wlp225s0 on 2026-10-07).
TRAIN_NETWORK_INTERFACE=$(ip route show default | awk '{print $5; exit}')
# Local docker daemon (harbor_env.sh would default this to a tcp://YOUR_DOCKER_HOST placeholder).
DOCKER_HOST=unix:///var/run/docker.sock
# This box has only 30GB RAM, and the 27B (cards 2-3) + opencode already hold ~10GB.
# Ray's default object store (40GB) overcommits the box and OOM-kills the 27B. Cap it.
RAY_OBJECT_STORE_MEMORY=2000000000

# --- model (Qwen3.5-2B) ---
MODEL_PATH=/home/nate/.cache/huggingface/hub/models--Qwen--Qwen3.5-2B/snapshots/15852e8c16360a2fea060d615a32b45270f8a8fc
SERVED_MODEL_NAME=qwen3.5-2b
TOOL_CALL_PARSER=qwen3_coder

# --- LoRA (parameter-efficient: freeze base, train adapters) ---
LORA_RANK=16
LORA_ALPHA=32
LORA_TARGET_MODULES=all-linear

# --- data (grid2op Harbor task index) ---
TRAIN_FILES=${TRAIN_FILES:-/home/nate/Documents/GridZero/lego/index/gridzero_train.parquet}
VAL_FILES=${VAL_FILES:-/home/nate/Documents/GridZero/lego/index/gridzero_val.parquet}

# --- cluster topology (one 2-GPU node, colocated) ---
NNODES=1
NGPUS_PER_NODE=2
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# --- model sizing (2B dense on 2x24GB, LoRA) ---
# SP=1. GEN_TP=2 -> 1 vLLM replica, TP=2 across both cards. One full 2B model
# offloads to CPU when asleep (~4G) instead of two replicas (~8G) — the box only
# has 30G RAM, so the single replica keeps us out of deep swap.
SP_SIZE=1
GEN_TP=2
# Sleep mode ON (level 1, forced by verl for LoRA): on sleep the vLLM pool is unmapped
# from the GPU — weights are copied to RAM (~2GB per TP worker) and the KV cache is
# DISCARDED (not offloaded; see vllm/device_allocator/cumem.py). That hands the whole
# vLLM region back to training. With sleep off, both phases split the 24GB permanently.
# It was off for the 10-07 smoke run because the 27B (~4GB RAM) left no room for the
# weight copy; the 27B is no longer resident.
ENABLE_SLEEP_MODE=True
# vLLM's share of each card during ROLLOUT only (freed on sleep). The KV cache is
# discarded on sleep, so this costs no RAM — the earlier 0.6->0.4 cut saved nothing.
# gpu_memory_utilization is vLLM's OWN budget — it does not subtract the FSDP actor already
# resident during rollout (4.7GB with ACTOR_FSDP_PARAM_OFFLOAD=False). 0.7 OOM'd once in
# vLLM's sampler warmup, which runs max_num_seqs (default 1024) dummy requests (needed
# 970MB, 660MB free). We never have more than ~16 sequences in flight, so cap max_num_seqs
# at 64 — that removes the warmup spike and lets 0.7 fit. Going higher (~0.85) needs
# ACTOR_FSDP_PARAM_OFFLOAD=True, which costs ~4-5GB more RAM.
GPU_MEM_UTIL=0.7
ROLLOUT_MAX_NUM_SEQS=64
# Context: extend to the model's native window (Qwen3.5-2B, RoPE, 212k). The
# multi-turn opencode prompt grows unbounded per episode and overflowed 65536
# at ~61 turns; 192k gives real headroom. KV cache (~1.2M tokens on these
# cards at GPU_MEM_UTIL=0.6) fits it easily; max concurrency drops to ~6x,
# still fine for our few in-flight sequences.
MAX_PROMPT=49152
MAX_RESP=147456
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=196608
USE_DYNAMIC_BSZ=False
# Fused log-prob kernels (impl_backend defaults to "torch"): FusedLinearForPPO
# computes log_probs/entropy in 512-token chunks WITHOUT materializing the full
# (T, vocab) logits tensor. Without it, a single ~60k-token sequence's lm_head
# projection needed ~18.5GB and OOMed the 24GB card (only ~14.6GB free).
FUSED_KERNELS=True
ENABLE_R3=False
VLLM_ENABLE_EXPERT_PARALLEL=False
# FSDP offload (params + optimizer to CPU) — cheap with LoRA, keeps VRAM low.
ACTOR_FSDP_PARAM_OFFLOAD=False
ACTOR_FSDP_OPTIMIZER_OFFLOAD=True
REF_FSDP_PARAM_OFFLOAD=True
# Activation offload off: a ~156k-token episode's activations (~16GB) don't fit on
# the 24GB GPU without it, but offloading them to CPU + the DataLoader + the 27B/Ray
# exceed the box's 30GB RAM and the OOM killer SIGKILLs a DataLoader worker. Instead
# we cap the episode length (HARBOR_AGENT_MAX_ITERATIONS) so sequences stay ~80k
# tokens, which fits the GPU with headroom and keeps CPU RAM low.
ENABLE_ACTIVATION_OFFLOAD=False

# --- algorithm (GRPO + GSPO) ---
ADV_ESTIMATOR=grpo
POLICY_LOSS_MODE=gspo
KL_LOSS_COEF=0.001
ENTROPY_COEFF=0.0

# --- optim ---
ACTOR_LR=1e-4
LR_SCHEDULER=constant

# --- cadence (log + validate frequently so we can watch the reward trend) ---
TOTAL_EPOCHS=1
TRAINER_VAL_BEFORE_TRAIN=True
TRAINER_TEST_FREQ=1
TRAINER_SAVE_FREQ=5

 # --- smoke scale (small batch; 3 train tasks x N_RESP rollouts per step) ---
 TRAIN_BSZ=${TRAIN_BSZ:-3}
 # data.train_batch_size is driven by TRAIN_PROMPT_BSZ (NOT TRAIN_BSZ); must be <= #train rows (3).
 TRAIN_PROMPT_BSZ=${TRAIN_PROMPT_BSZ:-3}
 TRAIN_MINI_BSZ=${TRAIN_MINI_BSZ:-3}
 N_RESP=${N_RESP:-4}
AGENT_NUM_WORKERS=4

# --- agent / harbor timeouts ---
# Cap the episode length. Each grid2op turn adds ~5k tokens (large observation), so
# 30 turns still yields ~150k-token sequences that OOM the 24GB GPU (~400MB short).
# 22 turns keeps sequences ~125k tokens, which fits the GPU with headroom (24
# turns / ~138k was ~100MB short). (60 turns -> ~156k tokens OOM'd; activation
# offload moved the OOM to CPU RAM instead.)
HARBOR_AGENT_MAX_ITERATIONS=7
HARBOR_AGENT_MAX_TIMEOUT_SEC=1800
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=1800
HARBOR_TRIALS_DIR=/home/nate/Documents/GridZero/lego/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
# oc scaffold on docker backend: agent-loop config that wires opencode's provider/runtime env.
# Must be AGENT_LOOP_CONFIG_PATH (that's what lego_rl_sync.yaml + scaffold/oc.env
# read). The old AGENT_LOOP_CONFIG name was ignored, so the run fell back to
# agent_loop_config_oh.yaml (KubernetesEnvironment) instead of the docker one.
AGENT_LOOP_CONFIG_PATH=/home/nate/Documents/lego-rl/src/verl_patch/config/agent_loop_config_oc_docker.yaml

# --- template composition ---
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
