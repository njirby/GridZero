+    assert n > 0
+    assert len(seg["response_mask"]) == n
+    assert len(seg["response_logprobs"]) == n
+    assert len(seg["response_routing"]) == n
+    assert len(seg["prompt_ids"]) == seg["initial_prompt_token_len"]
