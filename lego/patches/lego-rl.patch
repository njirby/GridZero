     for _ in $(seq 1 15); do
-        pgrep -f "VLLM::Worker|EngineCore|WorkerDict" 2>/dev/null | grep -vqw -e "$$" -e "$PPID" || break
+        local _left
+        _left=$(pgrep -f "VLLM::Worker|EngineCore|WorkerDict" 2>/dev/null \
+            | grep -vw -e "$$" -e "${PPID:-0}" \
+            | while read -r _p; do case "$_27b_protect" in *" ${_p} "*) ;; *) echo "$_p" ;; esac; done) || true  # pgrep exits 1 when nothing matches; under set -e+pipefail that aborted the launch
+        [ -z "$_left" ] && break
         sleep 1
     done
     rm -rf /tmp/ray/* 2>/dev/null || true
