+def _load_real_trace():
+    """Expand the delta-encoded real trace into ``_load_trace``-shaped requests."""
+    data = json.loads(_REAL_FIXTURE.read_text())
+    reqs = []
+    for r in data["requests"]:
+        if "extends" in r:
+            messages = reqs[r["extends"]]["messages"] + r["append"]
+        else:
+            messages = r["messages"]
+        tools = data["tools_table"][r["tools_ref"]] if r["tools_ref"] is not None else None
+        reqs.append({**r, "messages": messages, "tools": tools})
+    return reqs
+
+
+@pytest.mark.asyncio
+async def test_real_opencode_compaction_trace_replay():
+    reqs = _load_real_trace()
+    kinds = [r["kind"] for r in reqs]
+    i_comp = kinds.index("compaction")
+    post = [r for r in reqs if r["kind"] == "main_post_compaction"]
+    n_main_pre = kinds[:i_comp].count("main")
+    # Real-data shape this test pins: the kept tail starts at an assistant turn
+    # (no original user message survives compaction).
+    assert post[0]["messages"][0]["role"] == "system"
+    assert post[0]["messages"][1]["role"] == "assistant"
+    assert not any(
+        m["role"] == "user" and m["content"] == reqs[kinds.index("main")]["messages"][1]["content"]
+        for m in post[0]["messages"]
+    )
+
+    proxy = _proxy_for_generation()
+    sid = "session"
+    await proxy.open_session(sid)
+    for r in reqs:
+        await _send(proxy, sid, r["messages"], r["tools"], r["completion"])
+
+    comp_keys = [k for k in proxy._sessions if k.startswith(f"{sid}::compaction::")]
+    assert len(comp_keys) == 1
+    comp_st = proxy._sessions[comp_keys[0]]
+    assert comp_st["disable_proxy_trajectory"] is True
+    assert comp_st["compaction_main_session"] == sid
+    assert comp_st["traj_response_mask"] == []
+    hidden_keys = [k for k in proxy._sessions if k.startswith(f"{sid}::hidden::")]
+    assert len(hidden_keys) == kinds.count("hidden")
+    # Post-compaction requests all ran on the bare session.
+    assert [rid for rid, _ in proxy._server_manager.prompts[-len(post):]] == [sid] * len(post)
+
+    meta = await proxy.pop_session(sid)
+    segs = meta["segments"]
+    assert [s["reason"] for s in segs] == ["compaction", "final"]
+    assert [s["n_turns"] for s in segs] == [n_main_pre, len(post)]
+    for seg in segs:
+        _assert_segment_aligned(seg)
+    assert meta["n_compactions"] == 1
+    assert meta["compaction_calls"] == 1
+    assert meta["dropped_subagent_calls"] == kinds.count("hidden") + 1
+    assert meta["mismatch_rebuilds"] == 0
+    assert meta["num_calls"] == n_main_pre + len(post)
+
+    tpl = proxy._agent_loop.apply_chat_template
+    norm = _normalize_openai_messages_for_template
+    first_main = reqs[kinds.index("main")]
+    assert segs[0]["prompt_ids"] == await tpl(norm(first_main["messages"]), tools=first_main["tools"])
+    # Segment 2 starts at the first post-compaction request (tail + summary).
+    assert segs[1]["prompt_ids"] == await tpl(norm(post[0]["messages"]), tools=post[0]["tools"])
+    # Segment 1 ends with the last pre-compaction turn's generated tokens.
+    last_pre = reqs[i_comp - 1]["completion"]
+    out = _chars(json.dumps(last_pre)) + [_EOS]
+    assert segs[0]["response_ids"][-len(out) - 1 :] == out + [_NL]
+    assert meta["traj_acc_ids"] == segs[1]["prompt_ids"] + segs[1]["response_ids"]
