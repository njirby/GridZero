diff --git a/tests/agent_loop/test_builtin_swe_agent_loop.py b/tests/agent_loop/test_builtin_swe_agent_loop.py
index ea67635..05bd440 100644
--- a/tests/agent_loop/test_builtin_swe_agent_loop.py
+++ b/tests/agent_loop/test_builtin_swe_agent_loop.py
@@ -288,3 +288,213 @@ async def test_openai_trial_uses_chat_completions_base(tmp_path, monkeypatch):
     assert cfg["agent"]["extra_allowed_hosts"] == ["proxy"]
     assert "ANTHROPIC_BASE_URL" not in cfg["agent"]["env"]
     assert cfg["trial_name"].startswith("ohsdk-")
+
+
+# ------------------------------------------------------------------ run(): split episodes
+
+TASK = "/tasks/example"
+
+
+def segment(prompt, response, mask, reason, n_turns=None):
+    return {
+        "prompt_ids": list(prompt),
+        "response_ids": list(response),
+        "response_mask": list(mask),
+        "response_logprobs": [-0.1 * (i + 1) for i in range(len(response))],
+        "response_routing": [],
+        "initial_prompt_token_len": len(prompt),
+        "n_turns": n_turns if n_turns is not None else sum(
+            1 for i, v in enumerate(mask) if v and (i == 0 or not mask[i - 1])
+        ),
+        "reason": reason,
+    }
+
+
+def session(segments, final_assistant_msgs=1, **counters):
+    """pop_session()-shaped meta: flat traj_* keys = the last segment, plus ``segments``."""
+    last = segments[-1]
+    return {
+        "traj_acc_ids": last["prompt_ids"] + last["response_ids"],
+        "initial_prompt_token_len": len(last["prompt_ids"]),
+        "traj_response_mask": list(last["response_mask"]),
+        "traj_response_logprobs": list(last["response_logprobs"]),
+        "traj_response_routing": [],
+        "messages_snapshot": [{"role": "assistant", "content": "x"}] * final_assistant_msgs,
+        "num_calls": 5,
+        "segments": segments,
+        **counters,
+    }
+
+
+def make_run_loop(tmp_path, meta, reward=1.0, reason="agent_completed", response_length=8, max_turns=0):
+    loop = make_loop(tmp_path)
+    loop.response_length = response_length
+    loop.prompt_length = 100
+    loop._max_turns = max_turns
+    loop._tool_parser_name = "hermes"
+    selection = SimpleNamespace(
+        definition=loop.harnesses["openhands_sdk"], source="default"
+    )
+    loop.harness_resolver = SimpleNamespace(resolve=lambda kwargs, is_val=False: selection)
+
+    async def get_proxy():
+        return FakeProxy()
+
+    async def run_trial(**_):
+        return reward, reason, meta
+
+    loop._get_vllm_chat_proxy = get_proxy
+    loop._run_harbor_trial = run_trial
+    return loop
+
+
+async def run_loop(loop):
+    return await loop.run(
+        {},
+        raw_prompt=[{"role": "user", "content": TASK}],
+        extra_info={"harbor_task_path": TASK},
+        global_steps=4,
+    )
+
+
+THREE_WINDOWS = [
+    segment([1, 2], [10, 11, 12, 13], [1, 1, 0, 1], "compaction"),
+    segment([1, 3], [20, 21, 22], [1, 0, 0], "compaction"),
+    segment([1, 4], [30, 31], [1, 1], "final"),
+]
+
+
+@pytest.mark.asyncio
+async def test_compacted_episode_returns_one_row_per_window(tmp_path):
+    meta = session(THREE_WINDOWS, final_assistant_msgs=1, n_compactions=2, compaction_calls=2)
+    outputs = await run_loop(make_run_loop(tmp_path, meta, reward=0.75))
+
+    assert isinstance(outputs, list) and len(outputs) == 3
+    for i, (out, seg) in enumerate(zip(outputs, THREE_WINDOWS)):
+        assert out.prompt_ids == seg["prompt_ids"]
+        assert out.response_ids == seg["response_ids"]
+        assert out.response_mask == seg["response_mask"]
+        assert out.response_logprobs == seg["response_logprobs"]
+        assert out.num_turns == seg["n_turns"]
+        assert out.extra_fields["segment_idx"] == i
+        assert out.extra_fields["n_segments"] == 3
+        assert out.extra_fields["loss_weight"] == pytest.approx(1 / 3)
+        assert out.extra_fields["termination_reason"] == "agent_completed"
+        assert out.extra_fields["min_global_steps"] == 4
+    # the verifier reward sits on exactly one row: the last one with a model token
+    assert [o.reward_score for o in outputs] == [0.0, 0.0, 0.75]
