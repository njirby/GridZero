+# ---------------------------------------------------------------------------
+# Segment archiving across OpenCode compactions. A deterministic fake
+# tokenizer/model drives the real ``_generate_assistant_message`` path: one
+# token per character (id = ord + 100), special ids < 100.
+# ---------------------------------------------------------------------------
+
+import json
+from pathlib import Path
+
+from verl_patch.agent_loop.vllm_chat_completion_proxy import (
+    _SessionLevelScheduler,
+    _compaction_call_targets_thread,
+    _is_opencode_compaction_call,
+    _normalize_openai_messages_for_template,
+    _opencode_compaction_resume_index,
+)
+
+_FIXTURE = Path(__file__).parent / "fixtures" / "opencode_compaction_trace.json"
+_ROLE_IDS = {"system": 1, "user": 2, "assistant": 3, "tool": 4}
+_EOS, _NL, _TOOLS_HDR = 5, 6, 7
+_GEN_PROMPT = [_ROLE_IDS["assistant"]]
+
+
+def _chars(text: str) -> list[int]:
+    return [ord(c) + 100 for c in text]
+
+
+class _FakeAgentLoop:
+    async def apply_chat_template(self, messages, tools=None, remove_system_prompt=False):
+        ids = []
+        if tools:
+            ids += [_TOOLS_HDR] + _chars(json.dumps(tools, sort_keys=True))
+        for m in messages:
+            if remove_system_prompt and m.get("role") == "system":
+                continue
+            ids.append(_ROLE_IDS[m["role"]])
+            ids += _chars(m.get("content") or "")
+            if m.get("tool_calls"):
+                ids += _chars(json.dumps(m["tool_calls"], sort_keys=True))
+            ids += [_EOS, _NL]
+        return ids + _GEN_PROMPT
+
+
+class _FakeTokenizer:
+    def decode(self, ids, skip_special_tokens=False, clean_up_tokenization_spaces=False):
+        return "".join(chr(i - 100) for i in ids if i >= 100)
+
+
+class _FakeToolCall:
+    def __init__(self, d):
+        self._d = d
+
+    def model_dump(self, exclude_none=True):
+        return dict(self._d)
+
+
+class _FakeToolParser:
+    """Completions are JSON ``{"content", "tool_calls"?}`` emitted char-by-char."""
+
+    def extract_tool_calls(self, decoded, _request):
+        d = json.loads(decoded)
+        tcs = d.get("tool_calls") or []
+        return SimpleNamespace(
+            tools_called=bool(tcs),
+            tool_calls=[_FakeToolCall(tc) for tc in tcs],
+            content=d.get("content"),
+        )
+
+
+def _fake_prompt_logprob(position: int) -> float:
+    """Recompute fake: logprob of the token at sequence ``position``."""
+    return -1000.0 - position
+
+
+class _FakeServerManager:
+    def __init__(self, prompt_logprobs=False):
+        self.queue = []
+        self.prompts = []
+        self.prompt_logprobs = prompt_logprobs
+
+    async def generate(self, request_id, prompt_ids, sampling_params):
+        if request_id.endswith("-lprecompute"):
+            if not self.prompt_logprobs:
+                return SimpleNamespace(extra_fields={})
+            # vLLM layout: pl[m] is the logprob of the token at position m+1,
+            # plus a trailing dummy so len(pl) == len(prompt_ids).
+            pl = [_fake_prompt_logprob(m + 1) for m in range(len(prompt_ids) - 1)] + [None]
+            return SimpleNamespace(extra_fields={"prompt_logprobs": pl})
+        self.prompts.append((request_id, list(prompt_ids)))
+        ids = _chars(json.dumps(self.queue.pop(0))) + [_EOS]
+        return SimpleNamespace(
+            token_ids=ids,
+            log_probs=[-0.001 * (k + 1) for k in range(len(ids))],
+            stop_reason="stop",
+            num_preempted=0,
+            extra_fields={},
+            routed_experts=None,
+        )
+
+
+def _proxy_for_generation():
+    proxy = _proxy_for_routing()
+    proxy._agent_loop = _FakeAgentLoop()
+    proxy._tokenizer = _FakeTokenizer()
+    proxy._processor = None
+    proxy._server_manager = _FakeServerManager()
+    proxy._session_scheduler = _SessionLevelScheduler(proxy._server_manager)
+    proxy._vllm_tool_parser = _FakeToolParser()
+    proxy._max_consecutive_no_tool = 0
+    proxy._gen_prompt_len = len(_GEN_PROMPT)
+    proxy._assistant_eos_token_id = _EOS
+    proxy._assistant_eos_tail = [_NL]
+    proxy._session_attempt_seq = 0
+    return proxy
+
+
+async def _send(proxy, sid, messages, tools, completion):
+    proxy._server_manager.queue.append(completion)
+    msgs = _normalize_openai_messages_for_template(messages)
+    message, *_ = await proxy._generate_assistant_message(sid, msgs, tools, {})
+    return message
+
