     # Must be enabled! Otherwise, log_probs cannot be calculated.
     calculate_log_probs: True
 
+    # vLLM loads the real base from disk, so a LoRA run syncs only the adapter
+    # (engine_workers.update_weights) instead of streaming the whole model.
+    load_format: safetensors
