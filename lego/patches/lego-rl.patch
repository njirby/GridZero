diff --git a/src/verl_patch/config/lego_rl_sync.yaml b/src/verl_patch/config/lego_rl_sync.yaml
index ffa69a1..cdbf84d 100644
--- a/src/verl_patch/config/lego_rl_sync.yaml
+++ b/src/verl_patch/config/lego_rl_sync.yaml
@@ -15,6 +15,15 @@ actor_rollout_ref:
   rollout:
     name: vllm
     mode: async
+    # Load the real base model into vLLM from disk (not dummy weights). Then the
+    # weight sync only needs to stream the small LoRA delta instead of the whole
+    # model — required for layered_summon, and it cuts the per-card GPU peak at
+    # update_weights (the full-model all-gather was OOMing the 24GB card).
+    load_format: safetensors
+    # All-gather the LoRA delta layer-by-layer during weight sync instead of
+    # summoning the whole model at once — keeps the FSDP GPU footprint at its
+    # ~9G baseline rather than spiking to ~18G.
+    layered_summon: true
     val_kwargs:
       do_sample: True
     engine_kwargs:
