+def rebuild_3d_nested_from_values(nt: torch.Tensor) -> torch.Tensor:
+    """Rebuild a 3D jagged NestedTensor from its values + offsets.
+
+    After ``consolidate()`` and a Ray pickle/unpickle round-trip, a 3D jagged
+    NestedTensor (e.g. mRoPE ``position_ids``) can come back with the jagged marker
+    on the wrong dim (shape ``(B, j, total)`` instead of ``(B, rope_dim, j)``), which
+    breaks ``unbind``/``to_padded_tensor``. The underlying ``values`` tensor and
+    ``offsets`` are still intact, so we rebuild a well-formed NestedTensor with
+    ``as_nested_tensor`` (which sets the correct shape metadata).
+
+    Returns the original tensor unchanged if it is not a 3D nested tensor or the
+    layout cannot be determined.
+    """
+    if nt.dim() != 3 or not nt.is_nested:
+        return nt
+    try:
+        values = nt.values()
+        offsets = nt.offsets()
+        total = int(offsets[-1])
+        n = len(offsets) - 1
+        if values.dim() != 2 or n == 0:
+            return nt
+        if values.shape[-1] == total:
+            # (B, rope_dim, J): per-sample (rope_dim, L_i), ragged dim is last
+            per_sample = [values[:, int(offsets[i]) : int(offsets[i + 1])] for i in range(n)]
+            ragged_idx = 2
+        elif values.shape[0] == total:
+            # (B, J, rope_dim): per-sample (L_i, rope_dim), ragged dim is first
+            per_sample = [values[int(offsets[i]) : int(offsets[i + 1]), :] for i in range(n)]
+            ragged_idx = 1
+        else:
+            return nt
+        fixed = torch.nested.as_nested_tensor(per_sample, layout=torch.jagged)
+        fixed._ragged_idx = ragged_idx
+        return fixed
+    except Exception:
+        return nt
+
