+def _packed_segment_bounds(position_ids: torch.Tensor) -> list[tuple[int, int]]:
+    """Split a packed (1, seq_len) position_ids row into [start, end) segments where positions restart.
+
+    Same boundary rule as transformers' find_packed_sequence_indices; the tail padding added by
+    ulysses_pad (positions arange(pad_size)) becomes its own segment.
+    """
+    starts = (torch.diff(position_ids[0]) != 1).nonzero().flatten().add(1).tolist()
+    bounds = [0] + starts + [position_ids.size(-1)]
+    return list(zip(bounds[:-1], bounds[1:], strict=True))
+
+
+def _ulysses_sdpa_attention_forward(
+    module: torch.nn.Module,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    attention_mask: Optional[torch.Tensor],
+    dropout: float = 0.0,
+    scaling: Optional[float] = None,
+    is_causal: Optional[bool] = None,
+    position_ids: Optional[torch.Tensor] = None,
+    **kwargs,
+):
+    """Insert all-to-all before and after sdpa, the sdpa counterpart of `_ulysses_flash_attention_forward`.
+
+    Installed as ALL_ATTENTION_FUNCTIONS["sdpa"] when ulysses_sp_size > 1. RoPE has already been applied by the
+    caller with each rank's local positions, as in the flash attention path.
+
+    The incoming `attention_mask` was built by the model from the local shard and is ignored: causality and packed
+    sequence boundaries are recovered from the all-gathered position_ids, and each packed sequence runs as its own
+    causal sdpa call (no O(seq_len^2) mask). Only the remove-padding layout (batch size 1) is supported.
+
+    Args:
+        query (torch.Tensor): (batch_size, nheads, seqlen/sp_size, head_dim)
+        key (torch.Tensor): (batch_size, nheads_k, seqlen/sp_size, head_dim)
+        value (torch.Tensor): (batch_size, nheads_k, seqlen/sp_size, head_dim)
+        position_ids (torch.Tensor, optional): (batch_size, seqlen/sp_size)
+
+    Returns:
+        torch.Tensor: (batch_size, seqlen/sp_size, nheads, head_dim)
+    """
+    ulysses_sp_size = get_ulysses_sequence_parallel_world_size()
+
+    # Same ViT exclusion as the flash attention wrapper: vision attention doesn't pass position_ids.
+    if ulysses_sp_size <= 1 or position_ids is None:
+        return _ORIGINAL_SDPA_ATTENTION_FORWARD(
+            module, query, key, value, attention_mask, dropout=dropout, scaling=scaling, is_causal=is_causal, **kwargs
+        )
+
+    if query.size(0) != 1 or position_ids.dim() != 2 or position_ids.size(0) != 1:
+        raise NotImplementedError(
+            "Ulysses SP with attn_implementation=sdpa requires use_remove_padding=True (packed batch size 1), "
+            f"got query {tuple(query.shape)}, position_ids {tuple(position_ids.shape)}."
+        )
+
+    # NOTE: repeat kv heads to be divided by sequence parallel, see `_ulysses_flash_attention_forward`.
+    repeats = max(ulysses_sp_size // key.size(1), 1)
+    key = repeat_kv(key.transpose(1, 2), repeats).transpose(1, 2)
+    value = repeat_kv(value.transpose(1, 2), repeats).transpose(1, 2)
+
+    # (bsz, n_head, seq_len/n, head_dim) -> (bsz, n_head/n, seq_len, head_dim)
+    query = gather_seq_scatter_heads(query, seq_dim=2, head_dim=1)
+    key = gather_seq_scatter_heads(key, seq_dim=2, head_dim=1)
+    value = gather_seq_scatter_heads(value, seq_dim=2, head_dim=1)
+
+    # (bsz, seq_len/n) -> (bsz, seq_len)
+    position_ids_list = [torch.empty_like(position_ids) for _ in range(ulysses_sp_size)]
+    torch.distributed.all_gather(position_ids_list, position_ids, group=get_ulysses_sequence_parallel_group())
+    position_ids = torch.concat(position_ids_list, dim=-1)
+
+    # Each rank now holds a contiguous block of q heads plus the kv heads serving them, so the GQA ratio is
+    # local q heads / local kv heads (not module.num_key_value_groups once kv heads were repeated above).
+    sdpa_kwargs = {"enable_gqa": True} if query.size(1) != key.size(1) else {}
+    is_causal = is_causal if is_causal is not None else getattr(module, "is_causal", True)
+    attn_output = torch.cat(
+        [
+            torch.nn.functional.scaled_dot_product_attention(
+                query[:, :, start:end],
+                key[:, :, start:end],
+                value[:, :, start:end],
+                dropout_p=dropout,
+                scale=scaling,
+                is_causal=is_causal and end - start > 1,
+                **sdpa_kwargs,
+            )
+            for start, end in _packed_segment_bounds(position_ids)
+        ],
+        dim=2,
+    )
+
+    # (bsz, n_head/n, seq_len, head_dim) -> (bsz, n_head, seq_len/n, head_dim)
+    attn_output = gather_heads_scatter_seq(attn_output, seq_dim=2, head_dim=1)
+    return attn_output.transpose(1, 2).contiguous(), None
+
+
+def patch_sdpa_for_ulysses():
+    """Replace ALL_ATTENTION_FUNCTIONS["sdpa"] with `_ulysses_sdpa_attention_forward` (idempotent)."""
+    global _ORIGINAL_SDPA_ATTENTION_FORWARD
+    if _ORIGINAL_SDPA_ATTENTION_FORWARD is not None:
+        return
+
+    from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+
+    _ORIGINAL_SDPA_ATTENTION_FORWARD = ALL_ATTENTION_FUNCTIONS["sdpa"]
+    ALL_ATTENTION_FUNCTIONS["sdpa"] = _ulysses_sdpa_attention_forward
+    print("Monkey patch ALL_ATTENTION_FUNCTIONS['sdpa'] for Ulysses SP")
+
