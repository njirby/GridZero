+def _detach_tree(obj):
+    """Detach every tensor in a (nested) dict/list/TensorDict of model outputs."""
+    if isinstance(obj, torch.Tensor):
+        return obj.detach()
+    if isinstance(obj, dict):
+        return {k: _detach_tree(v) for k, v in obj.items()}
+    if isinstance(obj, list | tuple):
+        return type(obj)(_detach_tree(v) for v in obj)
+    if hasattr(obj, "detach") and callable(obj.detach):  # TensorDict
+        return obj.detach()
+    return obj
