+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Ulysses SP=2 vs SP=1 for Qwen3.5 full-attention layers with attn_implementation=sdpa, on CPU (gloo).
+
+A tiny Qwen3.5 with every layer full_attention (no FLA/triton needed) is driven the way
+FSDPEngineWithLMHead.prepare_model_inputs drives it with use_remove_padding=True + fused torch kernels:
+packed (1, total_nnz) input_ids, (4, 1, total_nnz) mRoPE position_ids, cu_seqlens, pre-sliced shift_labels,
+VLM path (pad only; Qwen3_5TextModel slices inputs_embeds after embedding).
+
+gloo has no list all_to_all, so verl's `dist.all_to_all` is emulated with `all_to_all_single` in this test only.
+
+    CUDA_VISIBLE_DEVICES="" python -m pytest -svv tests/models/test_qwen35_sdpa_ulysses_sp_on_cpu.py
+"""
+
+import os
+import socket
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+qwen35_config_mod = pytest.importorskip("transformers.models.qwen3_5.configuration_qwen3_5")
+
+SP_SIZE = 2
+TOL = 1e-4
+# (sequence lengths packed into one micro-batch) -- odd totals exercise ulysses_pad, [8, 8] puts a sequence
+# boundary exactly on the shard boundary.
+CASES = [[31], [7, 12, 6], [8, 8], [3, 20, 1, 9]]
+
+
+def _gloo_all_to_all(output_tensor_list, input_tensor_list, group=None, async_op=False):
+    assert not async_op
+    world_size = len(input_tensor_list)
+    send = torch.cat([t.contiguous().flatten() for t in input_tensor_list])
+    recv = torch.empty_like(send)
+    dist.all_to_all_single(recv, send, group=group)
+    for out, chunk in zip(output_tensor_list, recv.chunk(world_size), strict=True):
+        out.copy_(chunk.view_as(out))
+
+
+def _make_model():
+    from transformers.models.qwen3_5.modeling_qwen3_5 import Qwen3_5ForConditionalGeneration
+
+    config = qwen35_config_mod.Qwen3_5Config(
+        text_config=dict(
+            vocab_size=256,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=3,
+            num_attention_heads=8,
+            num_key_value_heads=2,
+            head_dim=64,
+            layer_types=["full_attention"] * 3,
+            rope_parameters={
+                "rope_type": "default",
+                "rope_theta": 10000.0,
+                "partial_rotary_factor": 0.25,
+                "mrope_section": [3, 3, 2],
+                "mrope_interleaved": True,
+            },
+            tie_word_embeddings=False,
+        ),
+        vision_config=dict(depth=1, hidden_size=32, intermediate_size=64, num_heads=2, out_hidden_size=128),
+        tie_word_embeddings=False,
+    )
+    config._attn_implementation = "sdpa"
+    config.text_config._attn_implementation = "sdpa"
+    torch.manual_seed(0)
+    model = Qwen3_5ForConditionalGeneration(config).float()
+    # Random init leaves q_norm/k_norm at identity and small weights; perturb so attention is non-trivial.
+    with torch.no_grad():
+        for p in model.parameters():
+            p.add_(torch.randn_like(p) * 0.05)
+    for p in model.parameters():
+        dist.broadcast(p.data, src=0)
+    return model
+
+
+def _forward(model, input_ids, position_ids, cu_seqlens, shift_labels):
+    out = model(
+        input_ids=input_ids,
+        attention_mask=None,
+        position_ids=position_ids,
+        cu_seqlens=cu_seqlens,
+        cu_seqlens_cpu=cu_seqlens.cpu(),
+        temperature=1.0,
+        shift_labels=shift_labels,
+        return_dict=True,
+        use_cache=False,
+    )
+    return out.log_probs.reshape(-1)
+
+
+def _grads(model):
+    return {n: p.grad.detach().clone() for n, p in model.named_parameters() if p.grad is not None}
+
+
+def _run_case(model, seqlens, sp_group, gen):
+    from verl.utils.ulysses import (
+        set_ulysses_sequence_parallel_group,
+        slice_input_tensor,
+        ulysses_pad,
+        ulysses_pad_and_slice_inputs,
+    )
+
+    total = sum(seqlens)
+    input_ids = torch.randint(0, 256, (1, total), generator=gen)
+    text_pos = torch.cat([torch.arange(n) for n in seqlens]).view(1, 1, total)
+    position_ids = text_pos.expand(4, 1, total).contiguous()
+    cu_seqlens = torch.tensor([0] + list(torch.tensor(seqlens).cumsum(0)), dtype=torch.long)
+    rolled = torch.roll(input_ids, shifts=-1, dims=1)
+    weights = torch.randn(total, generator=gen)
+
+    # SP=1 reference (HF sdpa with its own packed-sequence mask)
+    set_ulysses_sequence_parallel_group(None)
+    model.zero_grad(set_to_none=True)
+    ref_lp = _forward(model, input_ids, position_ids, cu_seqlens, rolled)
+    (ref_lp * weights).sum().backward()
+    ref_grads = _grads(model)
+
+    # SP=2: VLM path pads only, the text model slices inputs_embeds/position_ids after embedding.
+    set_ulysses_sequence_parallel_group(sp_group)
+    model.zero_grad(set_to_none=True)
+    ids_pad, pos_pad, pad_size = ulysses_pad(input_ids, position_ids, sp_size=SP_SIZE)
+    sp_cu_seqlens = cu_seqlens
+    if pad_size:
+        sp_cu_seqlens = torch.cat([cu_seqlens, cu_seqlens.new_tensor([total + pad_size])])
+    rolled_local, _, _ = ulysses_pad_and_slice_inputs(rolled, sp_size=SP_SIZE)
+    lp_local = _forward(model, ids_pad, pos_pad, sp_cu_seqlens, rolled_local)
+    w_local = slice_input_tensor(torch.nn.functional.pad(weights, (0, pad_size)).unsqueeze(0), dim=1, padding=False)
+    (lp_local * w_local.reshape(-1)).sum().backward()
+    sp_grads = _grads(model)
+    for g in sp_grads.values():
+        dist.all_reduce(g, group=sp_group)
+
+    gathered = [torch.empty_like(lp_local) for _ in range(SP_SIZE)]
+    dist.all_gather(gathered, lp_local.detach().contiguous(), group=sp_group)
+    sp_lp = torch.cat(gathered)[:total]
+    set_ulysses_sequence_parallel_group(None)
+
+    lp_diff = (sp_lp - ref_lp.detach()).abs().max().item()
+    assert ref_grads.keys() == sp_grads.keys()
+    grad_diff = max((sp_grads[n] - ref_grads[n]).abs().max().item() for n in ref_grads)
+    grad_scale = max(ref_grads[n].abs().max().item() for n in ref_grads)
+    return lp_diff, grad_diff, grad_scale
+
+
+def _worker(rank, world_size, port):
+    os.environ.update(MASTER_ADDR="127.0.0.1", MASTER_PORT=str(port))
+    dist.init_process_group("gloo", rank=rank, world_size=world_size)
+    dist.all_to_all = _gloo_all_to_all
+    torch.set_num_threads(2)
+    try:
+        from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+
+        from verl.models.transformers import monkey_patch
+        from verl.models.transformers.monkey_patch import apply_monkey_patch
+
+        model = _make_model()
+        apply_monkey_patch(
+            model,
+            ulysses_sp_size=SP_SIZE,
+            use_remove_padding=True,
+            use_fused_kernels=True,
+            fused_kernels_backend="torch",
+        )
+        assert ALL_ATTENTION_FUNCTIONS["sdpa"] is monkey_patch._ulysses_sdpa_attention_forward
+        sp_group = dist.group.WORLD
+        gen = torch.Generator().manual_seed(1234)
+
+        for seqlens in CASES:
+            lp_diff, grad_diff, grad_scale = _run_case(model, seqlens, sp_group, gen)
+            if rank == 0:
+                print(
+                    f"[sdpa SP{SP_SIZE}] seqlens={seqlens} logprob max|diff|={lp_diff:.3e} "
+                    f"grad max|diff|={grad_diff:.3e} (max|grad|={grad_scale:.3e})"
+                )
+            assert lp_diff < TOL, (seqlens, lp_diff)
+            assert grad_diff < TOL, (seqlens, grad_diff)
+
+        # Negative control: without the sdpa all-to-all, SP=2 attends only within each shard.
+        ALL_ATTENTION_FUNCTIONS["sdpa"] = monkey_patch._ORIGINAL_SDPA_ATTENTION_FORWARD
+        lp_diff, _, _ = _run_case(model, [31], sp_group, gen)
+        ALL_ATTENTION_FUNCTIONS["sdpa"] = monkey_patch._ulysses_sdpa_attention_forward
+        if rank == 0:
+            print(f"[sdpa SP{SP_SIZE}] negative control (unpatched sdpa) logprob max|diff|={lp_diff:.3e}")
+        assert lp_diff > 1e-2, lp_diff
+    finally:
+        dist.destroy_process_group()
+
+
+def _free_port():
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def test_qwen35_sdpa_ulysses_sp_matches_sp1_on_cpu():
+    mp.spawn(_worker, args=(SP_SIZE, _free_port()), nprocs=SP_SIZE, join=True)
