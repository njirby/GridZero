+# limitations under the License.
+
+"""Trajectory filter as the trainers run it: filter -> GRPO advantage -> zero filtered rows.
+
+Covers episode-level dropping (several rows sharing an ``episode_key`` go together), the
+per-reason drop metrics, the fail-loud paths, and that both trainer paths actually call it.
+"""
+
+import inspect
+
+import numpy as np
+import pytest
+import torch
+
+from verl import DataProto
+from verl.trainer.ppo.core_algos import AdvantageEstimator
+from verl.trainer.ppo.ray_trainer import RayPPOTrainer, compute_advantage
+from verl.trainer.ppo.trajectory_filter import (
+    EPISODE_KEY,
+    FILTER_MASK_KEY,
+    TERMINATION_REASON_KEY,
+    TerminationReason,
+    apply_trajectory_filter,
+    check_trajectory_filter_config,
+    zero_filtered_advantages,
+)
+
+C, T = TerminationReason.AGENT_COMPLETED, TerminationReason.TIMEOUT
+
+
+class _Cfg(dict):
+    """Stands in for TrajectoryFilterConfig / DictConfig."""
+
+
+def _batch(rewards, uids, reasons=None, episode_keys=None, resp_len=4):
+    n = len(rewards)
+    response_mask = torch.ones(n, resp_len)
+    scores = torch.zeros(n, resp_len)
+    scores[:, -1] = torch.tensor(rewards, dtype=torch.float32)
+    non_tensors = {"uid": np.array(uids, dtype=object)}
+    if reasons is not None:
+        non_tensors[TERMINATION_REASON_KEY] = np.array(reasons, dtype=object)
+    if episode_keys is not None:
+        non_tensors[EPISODE_KEY] = np.array(episode_keys, dtype=object)
+        # rows of one episode are its segments 0..N-1, in order (see split_rollouts.py)
+        non_tensors["segment_idx"] = np.array([episode_keys[:i].count(k) for i, k in enumerate(episode_keys)])
+        non_tensors["n_segments"] = np.array([episode_keys.count(k) for k in episode_keys])
+    return DataProto.from_dict(
+        tensors={"response_mask": response_mask, "token_level_scores": scores}, non_tensors=non_tensors
+    )
+
+
+def _fit_path(batch, config):
+    """The adv block of RayPPOTrainer.fit / SeparateRayPPOTrainer._fit_compute_advantage."""
+    batch.batch["token_level_rewards"] = batch.batch["token_level_scores"]
+    batch, metrics = apply_trajectory_filter(batch, config)
+    batch = compute_advantage(batch, adv_estimator=AdvantageEstimator.GRPO, num_repeat=1)
+    batch = zero_filtered_advantages(batch)
+    return batch, metrics
+
+
+def _row_adv(batch):
+    return batch.batch["advantages"][:, -1].tolist()
+
+
+def test_timeout_episode_spanning_two_rows_is_dropped_whole():
+    # Episode e0 spans rows 0-1; only row 0 carries the timeout tag. Both must go.
+    batch = _batch(
+        rewards=[1.0, 1.0, 0.0, 1.0, 1.0, 0.0],
+        uids=["a", "a", "a", "a", "b", "b"],
+        reasons=[T, C, C, C, C, C],
+        episode_keys=["e0", "e0", "e1", "e2", "e3", "e4"],
+    )
+    batch, metrics = _fit_path(batch, _Cfg(enable=True, drop_reasons=[T]))
+
+    assert list(batch.non_tensor_batch[FILTER_MASK_KEY]) == [True, True, False, False, False, False]
+    adv = _row_adv(batch)
+    assert adv[0] == 0.0 and adv[1] == 0.0
+    assert batch.batch["token_level_rewards"][:2].abs().sum() == 0
+    # Survivors of group "a" are normalized among themselves only (rewards 0 vs 1).
+    assert adv[2] < 0 < adv[3]
+    assert adv[2] == pytest.approx(-adv[3])
+    assert adv[4] > 0 > adv[5]
+
+    assert metrics[f"trajectory_filter/dropped_rows/{T}"] == 2
+    assert metrics[f"trajectory_filter/dropped_episodes/{T}"] == 1
+    assert metrics["trajectory_filter/dropped_rows"] == 2
+    assert metrics["trajectory_filter/dropped_episodes"] == 1
+    assert metrics["trajectory_filter/invalid_count"] == 2
+
+
+def test_single_row_episodes_drop_only_the_tagged_row():
+    # No episode_key: every row is its own episode (one row per episode today).
+    batch = _batch(
+        rewards=[1.0, 1.0, 0.0, 1.0],
+        uids=["a", "a", "a", "a"],
+        reasons=[T, C, C, C],
+    )
+    batch, metrics = _fit_path(batch, _Cfg(enable=True, drop_reasons=[T, TerminationReason.ENV_SETUP_FAILED]))
+
+    assert list(batch.non_tensor_batch[FILTER_MASK_KEY]) == [True, False, False, False]
+    adv = _row_adv(batch)
+    assert adv[0] == 0.0
+    assert all(a != 0.0 for a in adv[1:])
+    assert metrics[f"trajectory_filter/dropped_rows/{T}"] == 1
+    assert metrics[f"trajectory_filter/dropped_episodes/{T}"] == 1
+    assert metrics[f"trajectory_filter/dropped_rows/{TerminationReason.ENV_SETUP_FAILED}"] == 0
+
+
+def test_nothing_tagged_leaves_advantages_alone():
+    def run(config):
+        batch = _batch(rewards=[1.0, 0.0, 1.0], uids=["a", "a", "a"], reasons=[C, C, C])
+        return _row_adv(_fit_path(batch, config)[0])
+
+    assert run(_Cfg(enable=True, drop_reasons=[T])) == run(None)
+
+
+def test_enabled_filter_without_termination_reasons_fails_loud():
+    batch = _batch(rewards=[1.0, 0.0], uids=["a", "a"])
+    batch.batch["token_level_rewards"] = batch.batch["token_level_scores"]
+    with pytest.raises(ValueError, match="termination_reason"):
+        apply_trajectory_filter(batch, _Cfg(enable=True, drop_reasons=[T]))
+
+    # disabled, or nothing to drop: no reasons needed
+    apply_trajectory_filter(batch, _Cfg(enable=False))
+    apply_trajectory_filter(batch, _Cfg(enable=True, drop_reasons=[]))
+
+
+def test_config_check_rejects_unknown_reasons():
+    with pytest.raises(ValueError, match="unknown reasons"):
+        check_trajectory_filter_config(_Cfg(enable=True, drop_reasons=["timout"]))
+    check_trajectory_filter_config(_Cfg(enable=True, drop_reasons=[T]))
+    check_trajectory_filter_config(_Cfg(enable=False, drop_reasons=["timout"]))
+    check_trajectory_filter_config(None)
+
+
+def _assert_in_order(src, *needles):
+    positions = [src.index(n) for n in needles]
+    assert positions == sorted(positions), needles
+
+
+def test_both_trainer_paths_run_the_filter_around_advantage():
+    from verl.experimental.fully_async_policy.fully_async_trainer import FullyAsyncTrainer as _RemoteTrainer
+    from verl.experimental.separation.ray_trainer import SeparateRayPPOTrainer
+
+    FullyAsyncTrainer = _RemoteTrainer.__ray_actor_class__  # unwrap @ray.remote
+
+    order = ("apply_trajectory_filter(", "batch = compute_advantage(", "zero_filtered_advantages(")
+    _assert_in_order(inspect.getsource(RayPPOTrainer.fit), *order)
+    _assert_in_order(inspect.getsource(SeparateRayPPOTrainer._fit_compute_advantage), *order)
+    # The fully-async trainer reuses the separation trainer's advantage step.
+    assert FullyAsyncTrainer._fit_compute_advantage is SeparateRayPPOTrainer._fit_compute_advantage
+    assert "_fit_compute_advantage(" in inspect.getsource(FullyAsyncTrainer.fit_step)
+
+    for init in (RayPPOTrainer.__init__, FullyAsyncTrainer.__init__):
+        assert "check_trajectory_filter_config(" in inspect.getsource(init)
