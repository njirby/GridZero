+"""Full-model Qwen3.5 Ulysses SP=2 vs SP=1 check in the GridZero training configuration.
+
+Mirrors the FSDP engine's actor path: FSDPEngineWithLMHead.prepare_model_inputs / prepare_model_outputs,
+use_remove_padding=True, use_fused_kernels=True (torch backend), attn_implementation=sdpa, LoRA r16/a32
+all-linear, gradient checkpointing, fp32 params + bf16 autocast. FSDP itself is left out (it does not change
+the SP math); SP grads are averaged over the SP group the way FSDP's dp*sp reduction does.
+
+Per model it reports log-prob max/mean |diff| and LoRA-grad relative error for SP=2 vs SP=1, a bf16 noise floor
+(SP=1 bf16 vs SP=1 fp32), and a negative control (SP=2 with the sdpa all-to-all removed).
+
+Run (2 free GPUs; the script uses every process in the world as one SP group):
+    CUDA_VISIBLE_DEVICES=0,1 torchrun --nproc_per_node=2 \
+        tests/special_distributed/test_qwen35_full_model_sp_gridzero.py --models tiny,2b
+
+Script self-check on CPU (all-full-attention tiny model only, no FLA needed):
+    CUDA_VISIBLE_DEVICES="" torchrun --nproc_per_node=2 \
+        tests/special_distributed/test_qwen35_full_model_sp_gridzero.py --models tiny-full --device cpu
+"""
+
+import argparse
+import glob
+import os
+import sys
+
+import torch
+import torch.distributed as dist
+
+QWEN35_2B = (
+    "/home/nate/.cache/huggingface/hub/models--Qwen--Qwen3.5-2B/snapshots/15852e8c16360a2fea060d615a32b45270f8a8fc"
+)
+SP_SIZE = 2
+LP_MAX_TOL = float(os.environ.get("LP_MAX_TOL", "2e-2"))
+GRAD_REL_TOL = float(os.environ.get("GRAD_REL_TOL", "5e-2"))
+
+# packed micro-batches (sequence lengths); odd totals exercise ulysses_pad
+CASES = {
+    "tiny": [[255], [100, 60, 97]],
+    "tiny-full": [[255], [100, 60, 97]],
+    "2b": [[8191], [4000, 2500, 1693]],
+}
+
+
+def _rank0_print(*args):
+    if dist.get_rank() == 0:
+        print(*args, flush=True)
+
+
+def _gloo_all_to_all(output_tensor_list, input_tensor_list, group=None, async_op=False):
+    assert not async_op
+    send = torch.cat([t.contiguous().flatten() for t in input_tensor_list])
+    recv = torch.empty_like(send)
+    dist.all_to_all_single(recv, send, group=group)
+    for out, chunk in zip(output_tensor_list, recv.chunk(len(input_tensor_list)), strict=True):
+        out.copy_(chunk.view_as(out))
+
+
+def _tiny_config(layer_types):
+    from transformers.models.qwen3_5.configuration_qwen3_5 import Qwen3_5Config
+
+    return Qwen3_5Config(
+        text_config=dict(
+            vocab_size=1024,
+            hidden_size=256,
+            intermediate_size=512,
+            num_hidden_layers=len(layer_types),
+            num_attention_heads=8,
+            num_key_value_heads=2,
+            head_dim=64,
+            linear_key_head_dim=64,
+            linear_value_head_dim=64,
+            linear_num_key_heads=2,
+            linear_num_value_heads=4,
+            linear_conv_kernel_dim=4,
+            layer_types=layer_types,
+            rope_parameters={
+                "rope_type": "default",
+                "rope_theta": 10000.0,
+                "partial_rotary_factor": 0.25,
+                "mrope_section": [3, 3, 2],
+                "mrope_interleaved": True,
+            },
+            tie_word_embeddings=False,
+        ),
+        vision_config=dict(depth=1, hidden_size=32, intermediate_size=64, num_heads=2, out_hidden_size=256),
+        tie_word_embeddings=False,
+    )
+
+
+def _build_model(name, device):
+    from transformers import AutoConfig
+    from transformers.models.qwen3_5.modeling_qwen3_5 import Qwen3_5ForConditionalGeneration
+
+    torch.manual_seed(0)
+    if name == "2b":
+        config = AutoConfig.from_pretrained(QWEN35_2B)
+        config._attn_implementation = "sdpa"
+        config.text_config._attn_implementation = "sdpa"
+        model = Qwen3_5ForConditionalGeneration.from_pretrained(
+            QWEN35_2B, config=config, torch_dtype=torch.float32, attn_implementation="sdpa"
+        )
+    else:
+        layer_types = ["full_attention"] * 4 if name == "tiny-full" else ["linear_attention"] * 3 + ["full_attention"]
+        config = _tiny_config(layer_types)
+        config._attn_implementation = "sdpa"
+        config.text_config._attn_implementation = "sdpa"
+        model = Qwen3_5ForConditionalGeneration(config).float()
+        with torch.no_grad():
+            for p in model.parameters():
+                p.add_(torch.randn_like(p) * 0.02)
+    model = model.to(device)
+    for p in model.parameters():
+        dist.broadcast(p.data, src=0)
+    return model
+
+
+def _wrap_like_engine(model):
+    """apply_monkey_patch -> pass_packed_cu_seqlens -> gradient checkpointing -> LoRA, as FSDPEngine does."""
+    from inspect import signature
+
+    from peft import LoraConfig, TaskType, get_peft_model
+
+    from verl.models.transformers.monkey_patch import apply_monkey_patch
+
+    apply_monkey_patch(
+        model=model,
+        use_remove_padding=True,
+        ulysses_sp_size=SP_SIZE,
+        use_fused_kernels=True,
+        fused_kernels_backend="torch",
+    )
+    pass_packed_cu_seqlens = "cu_seqlens" in signature(model.forward).parameters
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+    model.enable_input_require_grads()
+    model = get_peft_model(
+        model,
+        LoraConfig(task_type=TaskType.CAUSAL_LM, r=16, lora_alpha=32, target_modules="all-linear", bias="none"),
+    )
+    # lora_B starts at zero (so lora_A grads would be zero); give both factors non-trivial grads.
+    torch.manual_seed(1)
+    with torch.no_grad():
+        for n, p in model.named_parameters():
+            if "lora_B" in n:
+                p.copy_(torch.randn_like(p) * 1e-2)
+            if p.requires_grad:
+                dist.broadcast(p.data, src=0)
+    model.train()
+    return model, pass_packed_cu_seqlens
+
+
+def _token_stream(name, n_tokens, vocab_size):
+    if name != "2b":
+        g = torch.Generator().manual_seed(7)
+        return torch.randint(0, vocab_size, (n_tokens,), generator=g).tolist()
+    # Natural text (this repo's own source) so log-probs are in a realistic range.
+    from transformers import AutoTokenizer
+
+    tok = AutoTokenizer.from_pretrained(QWEN35_2B)
+    root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+    ids = []
+    for path in sorted(glob.glob(os.path.join(root, "verl", "**", "*.py"), recursive=True)):
+        with open(path) as f:
+            ids.extend(tok(f.read(), add_special_tokens=False)["input_ids"])
+        if len(ids) >= n_tokens:
+            break
+    return ids[:n_tokens]
+
+
+def _micro_batch(seqlens, tokens, device):
+    from tensordict import TensorDict
+
+    from verl.utils import tensordict_utils as tu
+    from verl.utils.dataset.dataset_utils import DatasetPadMode
+
+    offsets = [0]
+    for n in seqlens:
+        offsets.append(offsets[-1] + n)
+    ids = [torch.tensor(tokens[s:e], device=device) for s, e in zip(offsets[:-1], offsets[1:], strict=True)]
+    pos = [torch.arange(n, device=device) for n in seqlens]
+    mb = TensorDict(
+        {
+            "input_ids": torch.nested.as_nested_tensor(ids, layout=torch.jagged),
+            "position_ids": torch.nested.as_nested_tensor(pos, layout=torch.jagged),
+        },
+        batch_size=[len(seqlens)],
+    )
+    tu.assign_non_tensor(
+        mb,
+        use_remove_padding=True,
+        use_fused_kernels=True,
+        pad_mode=DatasetPadMode.NO_PADDING,
+        pad_token_id=0,
+        temperature=1.0,
+        calculate_entropy=True,
+    )
+    return mb
+
+
+def _engine(model, pass_packed_cu_seqlens):
+    from verl.workers.engine.fsdp.transformer_impl import FSDPEngineWithLMHead
+
+    engine = FSDPEngineWithLMHead.__new__(FSDPEngineWithLMHead)
+    engine.module = model
+    engine.pass_packed_cu_seqlens = pass_packed_cu_seqlens
+    return engine
+
+
+def _run(engine, mb, sp_size, weights, autocast_dtype, device_type):
+    """One engine forward/backward. Returns (log_probs (total_nnz,), {lora param: grad})."""
+    from verl.utils.ulysses import set_ulysses_sequence_parallel_group
+
+    engine.use_ulysses_sp = sp_size > 1
+    engine.ulysses_sequence_parallel_size = sp_size
+    set_ulysses_sequence_parallel_group(dist.group.WORLD if sp_size > 1 else None)
+    model = engine.module
+    model.zero_grad(set_to_none=True)
+    try:
+        model_inputs, output_args = engine.prepare_model_inputs(mb)
+        if sp_size > 1:
+            assert "cu_seqlens" in model_inputs, "engine did not pass packed cu_seqlens"
+        with torch.autocast(device_type=device_type, dtype=autocast_dtype, enabled=autocast_dtype != torch.float32):
+            raw = model(**model_inputs, use_cache=False)
+            out = engine.prepare_model_outputs(raw, output_args, mb, None)
+        log_probs = out["log_probs"].values().float()
+        (log_probs * weights).sum().backward()
+    finally:
+        set_ulysses_sequence_parallel_group(None)
+    grads = {n: p.grad.detach().float().clone() for n, p in model.named_parameters() if p.requires_grad}
+    if sp_size > 1:
+        # FSDP averages over dp*sp ranks; gather_outputs_and_unpad scales grads by sp to compensate.
+        for g in grads.values():
+            dist.all_reduce(g)
+            g.div_(dist.get_world_size())
+    return log_probs.detach(), grads
+
+
+def _compare(ref_lp, lp, ref_g, g):
+    d = (lp - ref_lp).abs()
+    num = sum((g[n] - ref_g[n]).square().sum() for n in ref_g).sqrt().item()
+    den = sum(ref_g[n].square().sum() for n in ref_g).sqrt().item()
+    gmax = max((g[n] - ref_g[n]).abs().max().item() for n in ref_g)
+    return d.max().item(), d.mean().item(), num / (den + 1e-30), gmax
+
+
+def run_model(name, device, device_type):
+    from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+
+    from verl.models.transformers import monkey_patch
+
+    autocast_dtype = torch.float32 if device_type == "cpu" else torch.bfloat16
+    model, pass_packed = _wrap_like_engine(_build_model(name, device))
+    assert pass_packed, "Qwen3.5 forward does not accept cu_seqlens; is the PR #6660 cherry-pick applied?"
+    assert ALL_ATTENTION_FUNCTIONS["sdpa"] is monkey_patch._ulysses_sdpa_attention_forward, "sdpa not patched"
+    engine = _engine(model, pass_packed)
+    vocab = model.config.text_config.vocab_size if hasattr(model.config, "text_config") else model.config.vocab_size
+
+    ok = True
+    for seqlens in CASES[name]:
+        tokens = _token_stream(name, sum(seqlens), vocab)
+        mb = _micro_batch(seqlens, tokens, device)
+        weights = torch.randn(sum(seqlens), generator=torch.Generator().manual_seed(3)).to(device)
+
+        ref_lp, ref_g = _run(engine, mb, 1, weights, autocast_dtype, device_type)
+        lp, g = _run(engine, mb, SP_SIZE, weights, autocast_dtype, device_type)
+        lp_max, lp_mean, g_rel, g_max = _compare(ref_lp, lp, ref_g, g)
+
+        floor = ""
+        noise_max = 0.0
+        # fp32 FLA backward picks a TileLang kernel that doesn't compile on sm_86 (RTX 3090):
+        # set SKIP_FP32_FLOOR=1 there; the PASS criterion then relies on LP_MAX_TOL alone.
+        if autocast_dtype != torch.float32 and os.environ.get("SKIP_FP32_FLOOR") != "1":
+            fp32_lp, fp32_g = _run(engine, mb, 1, weights, torch.float32, device_type)
+            noise_max, noise_mean, noise_g_rel, _ = _compare(fp32_lp, ref_lp, fp32_g, ref_g)
+            floor = f" | bf16 noise floor (SP1 bf16 vs fp32): lp max={noise_max:.3e} mean={noise_mean:.3e} "
+            floor += f"grad rel={noise_g_rel:.3e}"
+
+        ALL_ATTENTION_FUNCTIONS["sdpa"] = monkey_patch._ORIGINAL_SDPA_ATTENTION_FORWARD
+        try:
+            bad_lp, _ = _run(engine, mb, SP_SIZE, weights, autocast_dtype, device_type)
+        finally:
+            ALL_ATTENTION_FUNCTIONS["sdpa"] = monkey_patch._ulysses_sdpa_attention_forward
+        bad_max = (bad_lp - ref_lp).abs().max().item()
+        bad_mean = (bad_lp - ref_lp).abs().mean().item()
+
+        passed = (lp_max < LP_MAX_TOL or lp_max <= noise_max) and g_rel < GRAD_REL_TOL
+        ok &= passed
+        _rank0_print(
+            f"[{name}] seqlens={seqlens} {'PASS' if passed else 'FAIL'}: SP{SP_SIZE} vs SP1 "
+            f"lp max={lp_max:.3e} mean={lp_mean:.3e} | lora grad rel={g_rel:.3e} max={g_max:.3e} "
+            f"(|ref lp| mean={ref_lp.abs().mean().item():.2f}){floor} | "
+            f"negative control (no sdpa all-to-all): lp max={bad_max:.3e} mean={bad_mean:.3e}"
+        )
+    del model, engine
+    if device_type == "cuda":
+        torch.cuda.empty_cache()
+    return ok
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--models", default="tiny,2b", help="comma list of tiny, tiny-full, 2b")
+    parser.add_argument("--device", default="cuda", choices=["cuda", "cpu"])
+    args = parser.parse_args()
+
+    if args.device == "cuda":
+        local_rank = int(os.environ["LOCAL_RANK"])
+        torch.cuda.set_device(local_rank)
+        dist.init_process_group("nccl")
+        device = torch.device("cuda", local_rank)
+    else:
+        dist.init_process_group("gloo")
+        dist.all_to_all = _gloo_all_to_all
+        device = torch.device("cpu")
+    assert dist.get_world_size() == SP_SIZE, f"run with --nproc_per_node={SP_SIZE}"
+
+    ok = True
+    for name in args.models.split(","):
+        ok &= run_model(name, device, args.device)
+    _rank0_print("ALL PASS" if ok else "SOME FAILED")
+    dist.destroy_process_group()
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
