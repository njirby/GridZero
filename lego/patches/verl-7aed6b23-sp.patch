+"""Multi-row episodes ("rollout splitting").
+
+An agent loop may return several ``AgentLoopOutput`` for one episode (e.g. one per context
+window when the agent compacts its context). Each becomes its own training row; the rows of
+one episode share
+
+- ``non_tensor_batch[EPISODE_KEY]``: a key unique to the episode,
+- ``SEGMENT_IDX_KEY`` / ``N_SEGMENTS_KEY``: the row's position 0..N-1 in the episode and N,
+- ``LOSS_WEIGHT_KEY``: 1/N, so the episode weighs as much as one unsplit row in the loss,
+- one outcome reward: it sits on exactly one row (the last one with a model token), the
+  others score 0, so summing ``token_level_rewards`` over the episode's rows gives the
+  episode's reward exactly as in the unsplit trajectory.
+
+The agent-loop worker adds ``SRC_ROW_KEY`` (index of the input row an output row came from)
+so the trainer can expand its input batch to the output rows.
+
+When no episode has more than one row everything here is a no-op and the trainer takes the
+exact pre-existing code path (``is_split_batch`` is False).
+"""
+
+import uuid
+from typing import Optional
+
+import numpy as np
+import torch
+
+from verl import DataProto
+from verl.trainer.ppo.trajectory_filter import EPISODE_KEY, FILTER_MASK_KEY
+
+SRC_ROW_KEY = "__src_row__"
+PAD_ROW_KEY = "__pad_row__"
+SEGMENT_IDX_KEY = "segment_idx"
+N_SEGMENTS_KEY = "n_segments"
+LOSS_WEIGHT_KEY = "loss_weight"
+
+
+def is_split_batch(batch: DataProto) -> bool:
+    """True when at least one episode spans more than one row."""
+    keys = batch.non_tensor_batch.get(EPISODE_KEY)
+    if keys is None:
+        return False
+    return len({str(k) for k in keys}) < len(keys)
+
+
+def _episode_rows(batch: DataProto) -> dict[str, list[int]]:
+    """Episode key -> its row indices, episodes in order of first appearance."""
+    rows: dict[str, list[int]] = {}
+    for i, k in enumerate(batch.non_tensor_batch[EPISODE_KEY]):
+        rows.setdefault(str(k), []).append(i)
+    return rows
+
+
+def _pad_mask(batch: DataProto) -> np.ndarray:
+    pad = batch.non_tensor_batch.get(PAD_ROW_KEY)
+    return np.zeros(len(batch), dtype=bool) if pad is None else np.asarray(pad, dtype=bool)
+
+
+def check_episodes(batch: DataProto, loss_weight: Optional[np.ndarray] = None) -> dict[str, list[int]]:
+    """Validate the per-episode row structure; returns ``_episode_rows``.
+
+    Raises if an episode's rows are not exactly segments 0..N-1 (one final row each), disagree
+    on N, or (when given) have loss weights that do not sum to 1.
+    """
+    seg = np.asarray(batch.non_tensor_batch[SEGMENT_IDX_KEY], dtype=np.int64)
+    nseg = np.asarray(batch.non_tensor_batch[N_SEGMENTS_KEY], dtype=np.int64)
+    episodes = _episode_rows(batch)
+    for key, rows in episodes.items():
+        n = int(nseg[rows[0]])
+        if (nseg[rows] != n).any() or sorted(seg[rows].tolist()) != list(range(n)):
+            raise ValueError(
+                f"episode {key}: rows must be segments 0..N-1 exactly once with one N; got "
+                f"segment_idx={seg[rows].tolist()} n_segments={nseg[rows].tolist()}"
+            )
+        if loss_weight is not None and abs(float(loss_weight[rows].sum()) - 1.0) > 1e-6:
+            raise ValueError(f"episode {key}: loss weights {loss_weight[rows].tolist()} do not sum to 1")
+    return episodes
+
+
+def slice_src_rows(output: DataProto, start: int, end: int) -> DataProto:
+    """Output rows generated from input rows [start, end); like ``output.slice(start, end)``
+    for one-row-per-input outputs. ``SRC_ROW_KEY`` is rebased to the slice."""
+    src = output.non_tensor_batch.get(SRC_ROW_KEY)
+    if src is None:
+        return output.slice(start, end)
+    src = np.asarray(src, dtype=np.int64)
+    if np.array_equal(src, np.arange(len(src))):
+        out = output.slice(start, end)
+    else:
+        out = output.select_idxs(np.nonzero((src >= start) & (src < end))[0])
+    out.non_tensor_batch[SRC_ROW_KEY] = np.asarray(out.non_tensor_batch[SRC_ROW_KEY], dtype=np.int64) - start
+    return out
+
+
+def expand_to_output_rows(batch: DataProto, output: DataProto) -> DataProto:
+    """Repeat the input rows of ``batch`` to line up with ``output``'s rows (pops ``SRC_ROW_KEY``).
+
+    Returns ``batch`` unchanged when every input row produced exactly one output row.
+    """
+    src = output.non_tensor_batch.pop(SRC_ROW_KEY, None)
+    if src is None:
+        return batch
+    src = np.asarray(src, dtype=np.int64)
+    if np.array_equal(src, np.arange(len(batch))):
+        return batch
+    if not np.array_equal(np.unique(src), np.arange(len(batch))):
+        raise ValueError(
+            f"generated rows do not cover the {len(batch)} input rows exactly (source rows {np.unique(src).tolist()})"
+        )
+    return batch.select_idxs(src)
+
+
+def collapse_split_episodes(output: DataProto) -> DataProto:
+    """One row per episode (its final segment) for validation; pops ``SRC_ROW_KEY``.
+
+    The final row's ``rm_scores`` and ``__num_turns__`` become the sums over the episode, so
+    ``rm_scores.sum(-1)`` is the episode's reward. No-op on one-row-per-input outputs.
+    """
+    src = output.non_tensor_batch.pop(SRC_ROW_KEY, None)
+    if src is None or not is_split_batch(output):
+        return output
+    if "rm_scores" not in output.batch.keys():
+        raise ValueError("split episodes need rm_scores from the agent loop (reward models score whole episodes)")
+    episodes = check_episodes(output)
+    seg = np.asarray(output.non_tensor_batch[SEGMENT_IDX_KEY], dtype=np.int64)
+    nseg = np.asarray(output.non_tensor_batch[N_SEGMENTS_KEY], dtype=np.int64)
+    finals = []
+    rm_scores = output.batch["rm_scores"].clone()
+    turns = output.non_tensor_batch.get("__num_turns__")
+    turns = None if turns is None else np.array(turns, copy=True)
+    for rows in episodes.values():
+        final = next(r for r in rows if seg[r] == nseg[r] - 1)
+        rm_scores[final] = output.batch["rm_scores"][rows].sum(dim=0)
+        if turns is not None:
+            turns[final] = np.asarray(output.non_tensor_batch["__num_turns__"])[rows].sum()
+        finals.append(final)
+    src = np.asarray(src, dtype=np.int64)
+    finals = np.asarray(finals, dtype=np.int64)[np.argsort(src[finals], kind="stable")]
+    if not np.array_equal(src[finals], np.arange(len(finals))):
+        raise ValueError(f"split episodes do not map one-to-one onto input rows: {src[finals].tolist()}")
+    output.batch["rm_scores"] = rm_scores
+    if turns is not None:
+        output.non_tensor_batch["__num_turns__"] = turns
+    return output.select_idxs(finals)
+
+
+def pad_to_divisible(batch: DataProto, k: int) -> DataProto:
+    """Append inert rows until ``len(batch) % k == 0``.
+
+    A pad row is a 2-token sequence (last prompt slot + first response slot attended, all
+    token ids 0, like the agent loop's env-failure dummy row) with ``response_mask`` 0,
+    zero rewards / log-probs / loss weight, its own ``uid`` and episode (singleton GRPO group
+    -> advantage 0), and ``PAD_ROW_KEY`` True (excluded from data metrics). It therefore adds
+    nothing to any loss term, whose denominators are fixed by the configured batch sizes.
+    """
+    n = len(batch)
+    n_pad = (-n) % k
+    if n_pad == 0:
+        return batch
+    pad = batch.select_idxs(np.zeros(n_pad, dtype=np.int64))
+    prompt_len = batch.batch["prompts"].shape[-1]
+    for key in list(pad.batch.keys()):
+        pad.batch[key] = torch.zeros_like(pad.batch[key])
+    attention_mask = pad.batch["attention_mask"]
+    attention_mask[:, prompt_len - 1 : prompt_len + 1] = 1
+    position_ids = batch.batch["position_ids"]
+    if position_ids.dim() != 2:
+        raise NotImplementedError("pad_to_divisible: only text-only (2-D) position_ids are supported")
+    pad.batch["position_ids"] = torch.clip(torch.cumsum(attention_mask, dim=-1) - 1, min=0).to(position_ids.dtype)
+
+    tag = uuid.uuid4().hex
+    nt = pad.non_tensor_batch
+    nt["uid"] = np.array([f"__pad__{tag}_{i}" for i in range(n_pad)], dtype=object)
+    nt[EPISODE_KEY] = nt["uid"].copy()
+    nt[SEGMENT_IDX_KEY] = np.zeros(n_pad, dtype=object)
+    nt[N_SEGMENTS_KEY] = np.ones(n_pad, dtype=object)
+    if "__num_turns__" in nt:
+        nt["__num_turns__"] = np.zeros(n_pad, dtype=nt["__num_turns__"].dtype)
+    nt[PAD_ROW_KEY] = np.ones(n_pad, dtype=bool)
+    batch.non_tensor_batch[PAD_ROW_KEY] = _pad_mask(batch)
+    return DataProto.concat([batch, pad])
+
+
+def prepare_split_batch(
+    batch: DataProto,
+    *,
+    dp_size: int,
+    rows_per_mini_batch: int,
+    adv_estimator,
+    use_critic: bool,
+    metrics: dict,
+) -> DataProto:
+    """Turn the generated rows into a trainable batch (call before ``_balance_batch``).
+
+    Unsplit batch: pops the agent loop's per-row ``LOSS_WEIGHT_KEY`` column (all 1), logs the
+    row/episode counts and returns the batch otherwise untouched -> the old code path.
+
+    Split batch: checks the episode structure, moves the loss weights to
+    ``batch.batch[LOSS_WEIGHT_KEY]`` (float32, consumed by the policy/entropy/KL loss
+    aggregation), and pads with inert rows to a multiple of ``dp_size * num_mini_batches``.
+    ``num_mini_batches`` stays what the config implies (episodes / rows_per_mini_batch); the
+    ROWS per mini-batch grow instead (see ``split_mini_batch_rows``), and every mini-batch
+    keeps the fixed loss denominator ``rows_per_mini_batch``.
+    """
+    from verl.trainer.ppo.core_algos import AdvantageEstimator
+
+    batch.non_tensor_batch.pop(SRC_ROW_KEY, None)
+    loss_weight = batch.non_tensor_batch.pop(LOSS_WEIGHT_KEY, None)
+    if not is_split_batch(batch):
+        if EPISODE_KEY in batch.non_tensor_batch:
+            metrics.update({"rollout/rows": len(batch), "rollout/episodes": len(batch), "rollout/split_episodes": 0})
+        return batch
+    if adv_estimator not in (AdvantageEstimator.GRPO, "grpo"):
+        raise NotImplementedError(f"split episodes support adv_estimator=grpo only, got {adv_estimator}")
+    if use_critic:
+        raise NotImplementedError("split episodes are not supported with a critic")
+    if loss_weight is None:
+        raise ValueError(f"split episodes need non_tensor_batch['{LOSS_WEIGHT_KEY}'] from the agent loop")
+    if "rm_scores" not in batch.batch.keys():
+        raise ValueError("split episodes need rm_scores from the agent loop (reward models score whole episodes)")
+    loss_weight = np.asarray(loss_weight, dtype=np.float64)
+    episodes = check_episodes(batch, loss_weight)
+    batch.batch[LOSS_WEIGHT_KEY] = torch.tensor(loss_weight, dtype=torch.float32)
+
+    n_episodes = len(episodes)
+    if n_episodes % rows_per_mini_batch:
+        raise ValueError(
+            f"{n_episodes} episodes is not a multiple of ppo_mini_batch_size*n={rows_per_mini_batch}; "
+            "split episodes keep the configured number of mini-batches"
+        )
+    num_mini_batches = n_episodes // rows_per_mini_batch
+    n_rows = len(batch)
+    batch = pad_to_divisible(batch, dp_size * num_mini_batches)
+    metrics.update(
+        {
+            "rollout/rows": n_rows,
+            "rollout/episodes": n_episodes,
+            "rollout/split_episodes": sum(len(rows) > 1 for rows in episodes.values()),
+            "rollout/pad_rows": len(batch) - n_rows,
+            "rollout/rows_per_mini_batch": len(batch) // num_mini_batches,
+        }
+    )
+    return batch
+
+
+def split_mini_batch_rows(batch: DataProto, rows_per_mini_batch: int) -> int:
+    """Rows per mini-batch for a prepared split batch: the configured number of mini-batches
+    (non-pad episodes / ``rows_per_mini_batch``) over all rows."""
+    pad = _pad_mask(batch)
+    n_episodes = len({str(k) for k, p in zip(batch.non_tensor_batch[EPISODE_KEY], pad, strict=True) if not p})
+    num_mini_batches = n_episodes // rows_per_mini_batch
+    if num_mini_batches == 0 or n_episodes % rows_per_mini_batch or len(batch) % num_mini_batches:
+        raise ValueError(
+            f"split batch of {len(batch)} rows / {n_episodes} episodes does not fit mini-batches of "
+            f"{rows_per_mini_batch} episodes (was it padded by prepare_split_batch?)"
+        )
+    return len(batch) // num_mini_batches
+
+
+def compute_split_grpo_advantage(
+    data: DataProto, norm_adv_by_std_in_grpo: bool = True, epsilon: float = 1e-6
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """GRPO with one sample per EPISODE, broadcast to all of the episode's rows.
+
+    The episode score is the sum of ``token_level_rewards`` over its rows (the reward sits on
+    one of them), so it is the unsplit trajectory's score even when the final segment has no
+    model token. The episode's group is the ``uid`` of its rows that the trajectory filter did
+    not neutralize; an episode with every row neutralized stays a singleton (advantage 0), as
+    an unsplit neutralized row does. Group mean/std are therefore those of the unsplit batch.
+    """
+    from verl.trainer.ppo.core_algos import compute_grpo_outcome_advantage
+
+    response_mask = data.batch["response_mask"]
+    row_scores = data.batch["token_level_rewards"].sum(dim=-1)
+    uids = data.non_tensor_batch["uid"]
+    invalid = data.non_tensor_batch.get(FILTER_MASK_KEY)
+    invalid = np.zeros(len(data), dtype=bool) if invalid is None else np.asarray(invalid, dtype=bool)
+    seg = np.asarray(data.non_tensor_batch[SEGMENT_IDX_KEY], dtype=np.int64)
+    nseg = np.asarray(data.non_tensor_batch[N_SEGMENTS_KEY], dtype=np.int64)
+
+    episodes = check_episodes(data)
+    row_episode = np.empty(len(data), dtype=np.int64)
+    scores, groups = [], []
+    for e, (key, rows) in enumerate(episodes.items()):
+        row_episode[rows] = e
+        scores.append(row_scores[rows].sum())
+        valid_uids = {uids[r] for r in rows if not invalid[r]}
+        if len(valid_uids) > 1:
+            raise ValueError(f"episode {key} spans GRPO groups {sorted(map(str, valid_uids))}")
+        final = next(r for r in rows if seg[r] == nseg[r] - 1)
+        groups.append(valid_uids.pop() if valid_uids else uids[final])
+
+    episode_scores = torch.stack(scores).unsqueeze(-1)
+    episode_adv, _ = compute_grpo_outcome_advantage(
+        token_level_rewards=episode_scores,
+        response_mask=torch.ones_like(episode_scores),
+        index=np.array(groups, dtype=object),
+        epsilon=epsilon,
+        norm_adv_by_std_in_grpo=norm_adv_by_std_in_grpo,
+    )
+    advantages = episode_adv[torch.from_numpy(row_episode), 0].unsqueeze(-1) * response_mask
+    return advantages, advantages
+
+
+def episode_sum(batch: DataProto, values: torch.Tensor, row_mask: torch.Tensor) -> torch.Tensor:
+    """Per-episode sums of ``values`` [bs], over episodes with at least one row in ``row_mask``."""
+    episodes = _episode_rows(batch)
+    sums = [values[rows].sum() for rows in episodes.values() if bool(row_mask[rows].any())]
+    return torch.stack(sums) if sums else values.new_zeros(0)
+
+
+def drop_pad_rows(batch: DataProto) -> DataProto:
+    pad = batch.non_tensor_batch.get(PAD_ROW_KEY)
+    if pad is None or not np.asarray(pad, dtype=bool).any():
+        return batch
+    return batch.select_idxs(np.nonzero(~np.asarray(pad, dtype=bool))[0])
